<?xml version="1.0" encoding="utf-8"?>
<!-- IchthysOS lock screen clock, Typographic: a large light weekday, the full date, and the time
     set small and bold in the accent, start aligned. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="start|top"
    android:gravity="start|top"
    android:orientation="vertical">

    <!-- The weekday shrinks to fit the width (WEDNESDAY, DONNERSTAG), sitting on the date. -->
    <TextClock
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:tag="text1|nolineheight"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:gravity="bottom|start"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="30sp"
        android:autoSizeMaxTextSize="54sp"
        android:autoSizeStepGranularity="1sp"
        android:textAllCaps="true"
        android:letterSpacing="0.02"
        android:textColor="#FFFFFFFF"
        android:textSize="54sp"
        android:format12Hour="EEEE"
        android:format24Hour="EEEE" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:tag="text2"
        android:fontFamily="sans-serif"
        android:singleLine="true"
        android:textColor="#CCFFFFFF"
        android:textSize="18sp"
        android:format12Hour="d MMMM yyyy"
        android:format24Hour="d MMMM yyyy" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:tag="accent1"
        android:fontFamily="sans-serif-black"
        android:singleLine="true"
        android:textColor="@android:color/system_accent1_100"
        android:textSize="34sp"
        android:format12Hour="h:mm a"
        android:format24Hour="HH:mm" />

</LinearLayout>
