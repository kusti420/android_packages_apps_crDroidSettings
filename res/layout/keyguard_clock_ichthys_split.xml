<?xml version="1.0" encoding="utf-8"?>
<!-- IchthysOS lock screen clock, Vertical Split: bold hours, an accent bar, then thin minutes over
     the weekday and date. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|top"
    android:gravity="center"
    android:orientation="horizontal">

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="text1|nolineheight"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="#FFFFFFFF"
        android:textSize="92sp"
        android:format12Hour="hh"
        android:format24Hour="HH" />

    <View
        android:layout_width="4dp"
        android:layout_height="96dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@android:color/system_accent1_200" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:orientation="vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="accent1|nolineheight"
            android:fontFamily="sans-serif-thin"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@android:color/system_accent1_100"
            android:textSize="60sp"
            android:format12Hour="mm"
            android:format24Hour="mm" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="text2"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:format12Hour="EEE d MMM"
            android:format24Hour="EEE d MMM" />
    </LinearLayout>

</LinearLayout>
