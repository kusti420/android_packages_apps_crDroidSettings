<?xml version="1.0" encoding="utf-8"?>
<!-- IchthysOS custom lockscreen clock: Center. Mirrors KeyguardCustomClockView.buildCenter(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|top"
    android:gravity="center_horizontal|top"
    android:orientation="vertical">

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="text1|nolineheight"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="#FFFFFFFF"
        android:textSize="60sp"
        android:format12Hour="hh:mm"
        android:format24Hour="HH:mm" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="accent1"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="@android:color/system_accent1_100"
        android:textSize="14sp"
        android:format12Hour="EEE, d MMM"
        android:format24Hour="EEE, d MMM" />

</LinearLayout>
