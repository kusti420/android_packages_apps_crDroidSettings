<?xml version="1.0" encoding="utf-8"?>
<!--
     IchthysOS: preference row rendered as a solid RED "danger" card, echoing the
     power-menu Emergency/SOS button.

     A17's SettingsPreferenceGroupAdapter.updateBackground() overwrites a normal
     row's itemView background with the Expressive surface card, which is why a
     plain android:background here never showed. The intended extension point is a
     DrawableStateLinearLayout root with a NON-null background: the adapter's
     branch 1 then PRESERVES our background and only drives its corner state
     (state_first/middle/last/single) via extraDrawableState. So we give it a red
     stateful drawable and get a full-bleed red card with the correct rounded
     corners for its position in the group. White text/icon for contrast.

     Standard preference view ids (@android:id/icon, @android:id/title,
     @android:id/summary, @android:id/widget_frame) are kept so the switch and
     text still bind. Do NOT add android:padding here — the adapter applies the
     background drawable's padding (matching every other card).
-->
<com.android.settingslib.widget.DrawableStateLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/ichthys_danger_bg_stateful"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/icon_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="56dp"
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="12dp">
        <com.android.internal.widget.PreferenceImageView
            android:id="@android:id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tint="#FFFFFFFF"
            android:maxWidth="36dp"
            android:maxHeight="36dp"/>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAppearance="?android:attr/textAppearanceListItem"
            android:textColor="#FFFFFFFF"
            android:ellipsize="marquee"/>

        <TextView
            android:id="@android:id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@android:id/title"
            android:layout_alignStart="@android:id/title"
            android:textAppearance="?android:attr/textAppearanceListItemSecondary"
            android:textColor="#E6FFFFFF"
            android:maxLines="10"
            android:ellipsize="end" />

    </RelativeLayout>

    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="end|center_vertical"
        android:paddingStart="16dp"
        android:orientation="vertical"/>

</com.android.settingslib.widget.DrawableStateLinearLayout>
