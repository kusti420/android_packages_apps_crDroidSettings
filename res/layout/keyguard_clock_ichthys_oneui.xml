<?xml version="1.0" encoding="utf-8"?>
<!-- IchthysOS lock screen clock, One UI Stacked: date on top, light hours over light minutes,
     centred, like One UI's stacked lock screen clock. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|top"
    android:gravity="center_horizontal|top"
    android:orientation="vertical">

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="text2"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:textColor="#E6FFFFFF"
        android:textSize="16sp"
        android:format12Hour="EEE, d MMMM"
        android:format24Hour="EEE, d MMMM" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:tag="text1|nolineheight"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="#FFFFFFFF"
        android:textSize="96sp"
        android:format12Hour="hh"
        android:format24Hour="HH" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-26dp"
        android:tag="text1|nolineheight"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="#FFFFFFFF"
        android:textSize="96sp"
        android:format12Hour="mm"
        android:format24Hour="mm" />

</LinearLayout>
