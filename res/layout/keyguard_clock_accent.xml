<?xml version="1.0" encoding="utf-8"?>
<!-- IchthysOS custom lockscreen clock: Accent. Mirrors KeyguardCustomClockView.buildAccent(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|top"
    android:gravity="center_horizontal|top"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="accent1|nolineheight"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@android:color/system_accent1_100"
            android:textSize="60sp"
            android:format12Hour="hh"
            android:format24Hour="HH" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:tag="text1|nolineheight"
            android:fontFamily="sans-serif-thin"
            android:includeFontPadding="false"
            android:text=":"
            android:textColor="#FFFFFFFF"
            android:textSize="60sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="text1|nolineheight"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="60sp"
            android:format12Hour="mm"
            android:format24Hour="mm" />

    </LinearLayout>

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="text2"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp"
        android:format12Hour="EEEE, MMM d"
        android:format24Hour="EEEE, MMM d" />

</LinearLayout>
