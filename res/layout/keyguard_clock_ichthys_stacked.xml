<?xml version="1.0" encoding="utf-8"?>
<!-- IchthysOS lock screen clock, Stacked Bold: heavy hours over accent minutes, weekday and date
     below, start aligned. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="start|top"
    android:gravity="start|top"
    android:orientation="vertical">

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="text1|nolineheight"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:letterSpacing="-0.04"
        android:textColor="#FFFFFFFF"
        android:textSize="104sp"
        android:format12Hour="hh"
        android:format24Hour="HH" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-30dp"
        android:tag="accent1|nolineheight"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:letterSpacing="-0.04"
        android:textColor="@android:color/system_accent1_100"
        android:textSize="104sp"
        android:format12Hour="mm"
        android:format24Hour="mm" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:tag="text2"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:format12Hour="EEEE · d MMM"
        android:format24Hour="EEEE · d MMM" />

</LinearLayout>
