<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/theme_quicksettings_title">

    <!-- Accent-tinted QS tile icon backgrounds (8.1-style circle behind active tiles).
         Backend: Settings.Secure "qs_accent_icon_bg", read in SystemUI CommonTile.kt. -->
    <com.crdroid.settings.preferences.SecureSettingSwitchPreference
        android:key="qs_accent_icon_bg"
        android:icon="@drawable/ic_sliders"
        android:title="@string/qs_accent_icon_bg_title"
        android:summary="@string/qs_accent_icon_bg_summary"
        android:defaultValue="true" />

</PreferenceScreen>
