<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings">

    <!-- Play Integrity Fix -->
    <Preference
        android:key="play_integrity_fix"
        android:icon="@drawable/ic_fingerprint"
        android:title="@string/play_integrity_fix_title"
        android:summary="@string/play_integrity_fix_summary"
        android:fragment="com.crdroid.settings.fragments.misc.PlayIntegrityFix" />

    <!-- TrickyStore -->
    <Preference
        android:key="tricky_store"
        android:icon="@drawable/ic_vpn_key"
        android:title="@string/tricky_store_title"
        android:summary="@string/tricky_store_summary"
        android:fragment="com.crdroid.settings.fragments.misc.TrickyStore" />

    <!-- Game Spoofing -->
    <!-- IchthysOS: removed game_spoofing (nothing reads spoof_gameprops_config). -->

    <!-- Gaming mode -->
    <!-- IchthysOS: removed gaming_mode (GameSpace app is not in the build). -->

    <!-- Application downgrade -->
    <com.crdroid.settings.preferences.GlobalSettingSwitchPreference
        android:key="pm_downgrade_allowed"
        android:icon="@drawable/ic_arrow_down_box"
        android:title="@string/app_downgrade_title"
        android:summary="@string/app_downgrade_summary"
        android:defaultValue="false"/>

    <!-- Sidebar -->
    <!-- IchthysOS: removed sidebar (Sidebar app is not in the build). -->

    <!-- Three fingers swipe action -->
    <ListPreference
        android:key="three_fingers_swipe"
        android:icon="@drawable/ic_three_finger_gesture"
        android:dialogTitle="@string/three_fingers_swipe_title"
        android:title="@string/three_fingers_swipe_title"
        android:entries="@array/hardware_keys_action_entries"
        android:entryValues="@array/hardware_keys_action_values"
        android:persistent="false" />

    <!-- Sensor block per package -->
    <!-- IchthysOS: removed sensor_block_settings (nothing reads sensor_block). -->

    <!-- Pocket Judge -->
    <com.crdroid.settings.preferences.SystemSettingSwitchPreference
        android:key="pocket_judge"
        android:icon="@drawable/ic_pocket"
        android:title="@string/pocket_judge_title"
        android:summary="@string/pocket_judge_summary"
        android:defaultValue="false" />

    <!-- Rotation button -->
    <com.crdroid.settings.preferences.SystemSettingSwitchPreference
        android:key="enable_rotation_button"
        android:icon="@drawable/ic_rotation"
        android:title="@string/floating_rotation_button_title"
        android:summary="@string/floating_rotation_button_summary"
        android:defaultValue="true" />

    <!-- Screen-on memory reclaim -->
    <com.crdroid.settings.preferences.SystemSettingSwitchPreference
        android:key="screen_on_memory_reclaim"
        android:icon="@drawable/ic_memory"
        android:title="@string/screen_on_memory_reclaim_title"
        android:summary="@string/screen_on_memory_reclaim_summary"
        android:defaultValue="true" />

    <!-- IchthysOS: Unrestricted background (tracker#39). Mode list + app picker + keep-after-
         reboot, all Settings.Global, applied live by UnrestrictedBackgroundController. Rows sit
         on the red danger card; the picker and persist rows are enabled in Miscellaneous.java
         only while a mode is on. -->
    <com.crdroid.settings.preferences.DangerGlobalListPreference
        android:key="ichthys_unrestricted_bg_mode"
        android:icon="@drawable/ic_battery_alert"
        android:title="@string/unrestricted_background_title"
        android:entries="@array/unrestricted_background_mode_entries"
        android:entryValues="@array/unrestricted_background_mode_values"
        android:defaultValue="0" />

    <Preference
        android:key="ichthys_unrestricted_bg_apps"
        android:icon="@drawable/ic_apps"
        android:title="@string/unrestricted_background_apps_title"
        android:fragment="com.crdroid.settings.fragments.misc.UnrestrictedBackgroundApps" />

    <com.crdroid.settings.preferences.DangerGlobalSwitchPreference
        android:key="ichthys_unrestricted_bg_persist"
        android:icon="@drawable/ic_restart"
        android:title="@string/unrestricted_background_persist_title"
        android:summary="@string/unrestricted_background_persist_summary"
        android:defaultValue="false" />

    <!-- IchthysOS: global "Manage app if unused" (app hibernation / auto-archive) master switch.
         Maps to Settings.Global.app_hibernation_enabled (default 1). Turn OFF to stop ALL apps
         from being auto-hibernated/archived (permissions kept, no auto-archive). -->
    <com.crdroid.settings.preferences.DeviceConfigSwitchPreference
        android:key="app_hibernation/app_hibernation_enabled"
        android:title="@string/app_hibernation_title"
        android:summary="@string/app_hibernation_summary"
        android:defaultValue="true" />

</PreferenceScreen>
