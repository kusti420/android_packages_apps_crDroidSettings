<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:key="monet_settings"
    android:title="@string/monet_title">

    <com.android.settingslib.widget.LayoutPreference
        android:key="monet_preview"
        android:layout="@layout/monet_preview"
        android:selectable="false"/>

    <ListPreference
        android:key="theme_style"
        android:title="@string/monet_engine_style_title"
        android:entries="@array/monet_engine_style_entries"
        android:entryValues="@array/monet_engine_style_values"
        android:defaultValue="0" />

    <ListPreference
        android:key="color_source"
        android:title="@string/monet_engine_color_source_title"
        android:entries="@array/monet_engine_color_source_entries"
        android:entryValues="@array/monet_engine_color_source_values"
        android:defaultValue="0" />

    <!-- IchthysOS: the accent colour itself is picked in Theme Studio > Accent colour (ThemeEngine);
         with the "preset" colour source this page keeps whatever is set there. The crDroid extras
         (background colour, luminance / chroma factors, whole palette, tint background) were
         removed: SystemUI's ThemeOverlayController in this tree reads none of them. -->

</PreferenceScreen>
