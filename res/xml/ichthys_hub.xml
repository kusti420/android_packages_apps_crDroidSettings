<!-- The one IchthysOS entry on the Settings homepage (crDroidSettingsLayout). The Protected card
     is the header and opens Guard; under it, every setting the ROM adds, each in one place
     (tracker#59):

       Theme                    theme_studio.xml: colour, shape, type, motion
       Lock screen              crdroid_settings_lockscreen.xml: the editor, fingerprint, AOD
       Status bar               crdroid_settings_statusbar.xml
       Quick settings           crdroid_settings_quicksettings.xml
       Navigation and buttons   crdroid_settings_button.xml
       Sound and notifications  crdroid_settings_sound.xml (Notifications one level down)
       Weather                  weather_settings.xml
       Privacy                  Guard (GuardActivity)
       Apps                     ichthys_apps.xml
       System                   ichthys_system.xml

     No setting lives on this page. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/crdroid_settings_title">

    <com.android.settings.ichthys.ShoalProtectedPreference
        android:key="ichthys_hub_protected">
        <intent
            android:targetPackage="com.android.settings"
            android:targetClass="com.android.settings.ichthys.guard.ui.GuardActivity" />
    </com.android.settings.ichthys.ShoalProtectedPreference>

    <Preference
        android:key="ichthys_hub_look"
        android:icon="@drawable/ic_color_bucket"
        android:title="@string/ichthys_hub_theme_title"
        android:summary="@string/ichthys_hub_theme_summary"
        android:fragment="com.crdroid.settings.fragments.themes.ThemeStudio" />

    <Preference
        android:key="ichthys_hub_lockscreen"
        android:icon="@drawable/ic_settings_lockscreens"
        android:title="@string/ichthys_hub_lockscreen_title"
        android:summary="@string/ichthys_hub_lockscreen_summary"
        android:fragment="com.crdroid.settings.fragments.LockScreen" />

    <Preference
        android:key="ichthys_hub_statusbar"
        android:icon="@drawable/ic_settings_statusbar"
        android:title="@string/ichthys_hub_statusbar_title"
        android:summary="@string/ichthys_hub_statusbar_summary"
        android:fragment="com.crdroid.settings.fragments.StatusBar" />

    <Preference
        android:key="ichthys_hub_quicksettings"
        android:icon="@drawable/ic_settings_quicksettings"
        android:title="@string/ichthys_hub_quicksettings_title"
        android:summary="@string/ichthys_hub_quicksettings_summary"
        android:fragment="com.crdroid.settings.fragments.QuickSettings" />

    <Preference
        android:key="ichthys_hub_navigation"
        android:icon="@drawable/ic_settings_navbar"
        android:title="@string/ichthys_hub_navigation_title"
        android:summary="@string/ichthys_hub_navigation_summary"
        android:fragment="com.crdroid.settings.fragments.Buttons" />

    <Preference
        android:key="ichthys_hub_sound"
        android:icon="@drawable/ic_settings_sound"
        android:title="@string/ichthys_hub_sound_title"
        android:summary="@string/ichthys_hub_sound_summary"
        android:fragment="com.crdroid.settings.fragments.Sound" />

    <Preference
        android:key="ichthys_hub_weather"
        android:icon="@drawable/ic_weather"
        android:title="@string/ichthys_hub_weather_title"
        android:summary="@string/ichthys_hub_weather_summary"
        android:fragment="com.crdroid.settings.fragments.WeatherSettings" />

    <!-- Guard is an activity, launched by explicit intent. -->
    <Preference
        android:key="ichthys_hub_privacy"
        android:icon="@drawable/ic_ichthys_guard"
        android:title="@string/ichthys_hub_privacy_title"
        android:summary="@string/ichthys_hub_privacy_summary">
        <intent
            android:targetPackage="com.android.settings"
            android:targetClass="com.android.settings.ichthys.guard.ui.GuardActivity" />
    </Preference>

    <Preference
        android:key="ichthys_hub_apps"
        android:icon="@drawable/ic_apps"
        android:title="@string/ichthys_hub_apps_title"
        android:summary="@string/ichthys_hub_apps_summary"
        android:fragment="com.crdroid.settings.fragments.IchthysApps" />

    <Preference
        android:key="ichthys_hub_system"
        android:icon="@drawable/ic_settings_main"
        android:title="@string/ichthys_hub_system_title"
        android:summary="@string/ichthys_hub_system_summary"
        android:fragment="com.crdroid.settings.fragments.IchthysSystem" />

</PreferenceScreen>
