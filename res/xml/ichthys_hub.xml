<!-- The one IchthysOS entry on the Settings homepage (crDroidSettingsLayout). The Protected card
     is the header and opens Guard; under it are the four areas everything else hangs off:

       Look     Theme Studio (theme_studio.xml) and the pages it links to
       Privacy  Guard (GuardActivity)
       Apps     ichthys_apps.xml
       System   ichthys_system.xml

     No setting lives on this page. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/crdroid_settings_title">

    <com.android.settings.ichthys.ShoalProtectedPreference
        android:key="ichthys_hub_protected">
        <intent
            android:targetPackage="com.android.settings"
            android:targetClass="com.android.settings.ichthys.guard.ui.GuardActivity" />
    </com.android.settings.ichthys.ShoalProtectedPreference>

    <Preference
        android:key="ichthys_hub_look"
        android:icon="@drawable/ic_color_bucket"
        android:title="@string/ichthys_hub_look_title"
        android:summary="@string/ichthys_hub_look_summary"
        android:fragment="com.crdroid.settings.fragments.themes.ThemeStudio" />

    <!-- Guard is an activity, launched by explicit intent. -->
    <Preference
        android:key="ichthys_hub_privacy"
        android:icon="@drawable/ic_ichthys_guard"
        android:title="@string/ichthys_hub_privacy_title"
        android:summary="@string/ichthys_hub_privacy_summary">
        <intent
            android:targetPackage="com.android.settings"
            android:targetClass="com.android.settings.ichthys.guard.ui.GuardActivity" />
    </Preference>

    <Preference
        android:key="ichthys_hub_apps"
        android:icon="@drawable/ic_apps"
        android:title="@string/ichthys_hub_apps_title"
        android:summary="@string/ichthys_hub_apps_summary"
        android:fragment="com.crdroid.settings.fragments.IchthysApps" />

    <Preference
        android:key="ichthys_hub_system"
        android:icon="@drawable/ic_settings_main"
        android:title="@string/ichthys_hub_system_title"
        android:summary="@string/ichthys_hub_system_summary"
        android:fragment="com.crdroid.settings.fragments.IchthysSystem" />

</PreferenceScreen>
