<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    xmlns:lineage="http://schemas.android.com/apk/res-auto">

    <com.android.settingslib.widget.LayoutPreference
        android:key="clock_preview"
        android:layout="@layout/lockscreen_clock_preview"
        android:selectable="false"
        settings:allowDividerBelow="true"
        settings:isPreferenceVisible="true" />
 
    <com.crdroid.settings.preferences.SecureSettingListPreference
        android:key="lock_screen_custom_clock_color_mode"
        android:title="@string/lockscreen_custom_clock_color_mode_title"
        android:entries="@array/lockscreen_custom_clock_color_mode_entries"
        android:entryValues="@array/lockscreen_custom_clock_color_mode_values"
        android:summary="%s"
        android:defaultValue="default" />

    <com.crdroid.settings.preferences.SecureSettingSeekBarPreference
        android:key="lock_screen_custom_clock_size_scale"
        android:title="@string/lockscreen_custom_clock_size_title"
        android:summary="@string/lockscreen_custom_clock_size_summary"
        android:defaultValue="100"
        android:max="150"
        settings:min="50"
        settings:units="%" />

    <com.crdroid.settings.preferences.colorpicker.SecureSettingColorPickerPreference
        android:key="lock_screen_custom_clock_custom_color"
        android:title="@string/custom_color"
        android:defaultValue="0xFFFFFFFF" />

    <com.crdroid.settings.preferences.SecureSettingSeekBarPreference
        android:key="lock_screen_custom_clock_opacity"
        android:title="@string/lockscreen_custom_clock_opacity_title"
        android:summary="@string/lockscreen_custom_clock_opacity_summary"
        android:defaultValue="100"
	    android:max="100"
        settings:min="10" 
        settings:units="%" />

    <com.crdroid.settings.preferences.SecureSettingSwitchPreference
        android:key="lock_screen_custom_clock_aod_anim"
        android:title="@string/lockscreen_custom_clock_aod_anim_title"
        android:summary="@string/lockscreen_custom_clock_aod_anim_summary"
        android:defaultValue="true" />

    <!-- IchthysOS: the lock screen editor moves the clock from -10 % to +45 % of the screen's
         height (about -225 .. +1095 px here); the slider covers that, so it never clamps. -->
    <com.crdroid.settings.preferences.SecureSettingSeekBarPreference
        android:key="lock_screen_custom_clock_margin_top"
        android:title="@string/lockscreen_custom_clock_frame_margin_top_title"
        android:summary="@string/lockscreen_custom_clock_frame_margin_top_summary"
        android:defaultValue="15"
        android:max="1100"
        settings:min="-250" 
        settings:units="@string/unit_pixels" />

    <!-- IchthysOS: options for the drawn "Shoal" faces (Shoal Lattice ... Word Grid). -->
    <com.crdroid.settings.preferences.SecureSettingSwitchPreference
        android:key="ichthys_clock_show_date"
        android:title="@string/ichthys_clock_show_date_title"
        android:summary="@string/ichthys_clock_show_date_summary"
        android:defaultValue="true" />

    <com.crdroid.settings.preferences.SecureSettingListPreference
        android:key="ichthys_clock_dot_shape"
        android:title="@string/ichthys_clock_dot_shape_title"
        android:entries="@array/ichthys_clock_dot_shape_entries"
        android:entryValues="@array/ichthys_clock_dot_shape_values"
        android:summary="%s"
        android:defaultValue="0" />

    <com.crdroid.settings.preferences.SecureSettingSwitchPreference
        android:key="ichthys_clock_unlit_dots"
        android:title="@string/ichthys_clock_unlit_dots_title"
        android:summary="@string/ichthys_clock_unlit_dots_summary"
        android:defaultValue="true" />

    <com.android.settingslib.widget.FooterPreference
        android:key="custom_clock_style_info"
        android:title="@string/lockscreen_custom_clock_style_info"
        android:selectable="false"
        settings:searchable="false" />

</PreferenceScreen>
