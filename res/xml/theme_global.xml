<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/theme_global_title">

    <!-- IchthysOS Theme Engine (8.1/Substratum-inspired accent palette + custom picker).
         Built as a dedicated fragment (com.crdroid.settings.fragments.themes.ThemeEngine),
         NOT the stock Monet UI. -->
    <Preference
        android:key="theme_engine"
        android:icon="@drawable/ic_format_paint"
        android:title="@string/theme_engine_title"
        android:summary="@string/theme_engine_summary"
        android:fragment="com.crdroid.settings.fragments.themes.ThemeEngine" />

    <!-- Pitch black theme lives inside the Theme engine screen now
         (com.crdroid.settings.fragments.themes.ThemeEngine), alongside the
         Substratum/Monet palette-style selector. -->

</PreferenceScreen>
