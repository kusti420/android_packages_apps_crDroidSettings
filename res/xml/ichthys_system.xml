<!-- IchthysOS > System: how the phone behaves (as opposed to how it looks, which is Look).

     ichthys_screenshot_preview_timeout was on the old User interface tab; its ichthys.nix option
     keeps its path (system.ui.screenshotPreviewTimeout, set in
     frameworks/base/tools/ichthys-config/gen_crdroid_options.py). -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/ichthys_hub_system_title">




    <PreferenceCategory
        android:key="ichthys_system_battery_display_category"
        android:title="@string/ichthys_system_battery_display_category">

        <!-- Charging control (charge limit / smart charging). Backed by
             vendor.lineage.health.IChargingControl -> batt_slate_mode. IchthysSystem.java removes
             this entry when HealthInterface reports the feature unsupported. -->
        <Preference
            android:key="charging_control"
            android:icon="@drawable/ic_battery_charging_full"
            android:title="@string/charging_control_title"
            android:summary="@string/charging_control_summary"
            android:fragment="com.crdroid.settings.fragments.health.ChargingControlSettings" />

        <!-- IchthysOS: the charger-connected animation (wired and wireless, lock screen and over
             apps), played by SystemUI's WiredChargingRippleController / ShoalChargingView. -->
        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_charging_animation"
            android:icon="@drawable/ic_battery_charging"
            android:title="@string/ichthys_charging_animation_title"
            android:dialogTitle="@string/ichthys_charging_animation_title"
            android:entries="@array/ichthys_charging_animation_entries"
            android:entryValues="@array/ichthys_charging_animation_values"
            android:summary="%s"
            settings:keywords="@string/ichthys_charging_animation_keywords"
            android:defaultValue="pulse" />

        <!-- IchthysOS: with the screen off, connecting power turns it on to play the animation.
             Off: the animation is skipped and the screen stays off. IchthysSystem greys this
             out while the style is Off. -->
        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="ichthys_charging_animation_wake"
            android:icon="@drawable/ic_power"
            android:title="@string/ichthys_charging_animation_wake_title"
            android:summary="@string/ichthys_charging_animation_wake_summary"
            android:defaultValue="false" />

        <!-- Smart Pixels -->
        <Preference
            android:key="smart_pixels"
            android:icon="@drawable/ic_smart_pixels"
            android:title="@string/smart_pixels_title"
            android:summary="@string/smart_pixels_summary"
            android:fragment="com.crdroid.settings.fragments.ui.SmartPixels" />

        <!-- How long the screenshot preview stays. -->
        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_screenshot_preview_timeout"
            android:icon="@drawable/ic_timelapse_cr"
            android:title="@string/ichthys_screenshot_preview_timeout_title"
            android:entries="@array/ichthys_screenshot_preview_timeout_entries"
            android:entryValues="@array/ichthys_screenshot_preview_timeout_values"
            android:summary="%s"
            android:defaultValue="0" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="ichthys_security_category"
        android:title="@string/ichthys_security_category">

        <!-- Duress / emergency wipe credential. Enforcement lives in LockSettingsService;
             this entry only leads to the screen that sets it. -->
        <Preference
            android:key="duress_credential"
            android:icon="@drawable/ic_lock_alert"
            android:title="@string/duress_credential_title"
            android:summary="@string/duress_credential_summary"
            settings:keywords="@string/duress_credential_keywords"
            android:fragment="com.crdroid.settings.fragments.security.DuressCredentialSettings" />

        <!-- IchthysOS: auto reboot. IchthysAutoRebootService (system_server) restarts the phone
             after it stayed locked this long, so user data is at rest again. The key holds
             milliseconds, 0 is off; unset is 18 hours (the defaultValue here and in the service,
             ichthys.nix security.autoReboot). -->
        <com.crdroid.settings.preferences.GlobalSettingListPreference
            android:key="ichthys_auto_reboot_timeout"
            android:icon="@drawable/ic_restart"
            android:title="@string/ichthys_auto_reboot_title"
            android:dialogTitle="@string/ichthys_auto_reboot_title"
            android:entries="@array/ichthys_auto_reboot_entries"
            android:entryValues="@array/ichthys_auto_reboot_values"
            android:summary="%s"
            settings:keywords="@string/ichthys_auto_reboot_keywords"
            android:defaultValue="64800000" />
    </PreferenceCategory>

    <!-- ichthys.nix -->
    <PreferenceCategory
        android:key="theme_studio_config"
        android:title="@string/theme_studio_config_category">

        <Preference
            android:key="theme_studio_import"
            android:icon="@drawable/ic_backup"
            android:title="@string/theme_studio_import_title"
            android:summary="@string/theme_studio_import_summary" />

        <Preference
            android:key="theme_studio_export"
            android:icon="@drawable/ic_backup"
            android:title="@string/theme_studio_export_title"
            android:summary="@string/theme_studio_export_summary" />

        <Preference
            android:key="theme_studio_generations"
            android:icon="@drawable/ic_backup"
            android:title="@string/theme_studio_generations_title"
            android:summary="@string/theme_studio_generations_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="ichthys_about_category"
        android:title="@string/about_crdroid">

        <!-- Changelog -->
        <Preference
            android:key="crdroid_changelog"
            android:icon="@drawable/ic_changelog"
            android:title="@string/changelog_crdroid_title"
            android:summary="@string/changelog_crdroid_summary">
            <intent android:action="android.intent.action.MAIN"
                 android:targetPackage="com.android.settings"
                 android:targetClass="com.crdroid.settings.fragments.about.ChangelogActivity"/>
        </Preference>

        <!-- IchthysOS GitHub -->
        <Preference
            android:key="crdroid_source"
            android:icon="@drawable/ic_source"
            android:title="@string/crdroid_source_title"
            android:summary="@string/crdroid_source_summary" />

        <!-- IchthysOS Telegram Community -->
        <Preference
            android:key="crdroid_telegram"
            android:icon="@drawable/ic_telegram"
            android:title="@string/crdroid_telegram_title"
            android:summary="@string/crdroid_telegram_summary" />
    </PreferenceCategory>

</PreferenceScreen>
