<!-- Look > Status bar: everything about the status bar's look and content: clock, battery,
     logo, which icons show, notification dot, privacy indicators, weather and spacing. The
     status bar gestures are in System > Buttons & gestures (crdroid_settings_button.xml) and
     the notification count / icon limit in System > Notifications
     (crdroid_settings_notifications.xml).

     This file is the "statusBar" page for
     frameworks/base/tools/ichthys-config/gen_crdroid_options.py. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    xmlns:lineage="http://schemas.android.com/apk/res-auto"
    android:title="@string/ichthys_hub_statusbar_title">

    <PreferenceCategory
        android:key="look_status_bar_style_category"
        android:title="@string/look_status_bar_style_category">

        <ListPreference
            android:key="theme_studio_statusbar"
            android:icon="@drawable/ic_grid_view"
            android:title="@string/theme_studio_statusbar_title"
            android:summary="%s"
            android:entries="@array/theme_studio_statusbar_entries"
            android:entryValues="@array/theme_studio_statusbar_values"
            android:persistent="false" />
        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="statusbar_colored_icons"
            android:icon="@drawable/ic_shapes"
            android:title="@string/statusbar_colored_icons_title"
            android:summary="@string/statusbar_colored_icons_summary"
            android:defaultValue="false" />
    </PreferenceCategory>


    <!-- Clock -->
    <PreferenceCategory
        android:key="look_status_bar_clock_category"
        android:title="@string/qs_clock_title">

        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_clock"
            android:icon="@drawable/ic_clock"
            android:title="@string/status_bar_clock_position_title"
            android:summary="%s"
            android:dialogTitle="@string/status_bar_clock_position_title"
            android:entries="@array/status_bar_clock_position_entries"
            android:entryValues="@array/status_bar_clock_position_values"
            android:defaultValue="2" />

        <Preference
            android:key="clock"
            android:icon="@drawable/ic_clock"
            android:title="@string/status_bar_clock_title"
            android:summary="@string/status_bar_clock_summary"
            android:fragment="com.crdroid.settings.fragments.statusbar.Clock" />

        <com.crdroid.settings.preferences.ClockBackgroundChipPreference
            android:key="statusbar_clock_chip"
            android:icon="@drawable/ic_clock"
            android:title="@string/statusbar_clock_chip_title"
            android:summary="@string/statusbar_clock_chip_summary" />
    </PreferenceCategory>

    <!-- Battery: icon style, percentage, colours, the quick settings header icon and the
         battery bar are one page (status_bar_battery.xml). -->
    <PreferenceCategory
        android:key="look_status_bar_battery_category"
        android:title="@string/look_battery_title">

        <Preference
            android:key="battery_icon"
            android:icon="@drawable/ic_battery"
            android:title="@string/look_battery_title"
            android:summary="@string/look_battery_summary"
            android:fragment="com.crdroid.settings.fragments.statusbar.BatteryIcon" />
    </PreferenceCategory>

    <!-- Custom logo -->
    <PreferenceCategory
        android:key="look_status_bar_logo_category"
        android:title="@string/status_bar_logo_title">

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_logo"
            android:icon="@drawable/ic_tag"
            android:title="@string/status_bar_logo_title"
            android:summary="@string/status_bar_logo_summary" />

        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="status_bar_logo_position"
            android:icon="@drawable/ic_tag"
            android:title="@string/status_bar_logo_position_title"
            android:entries="@array/status_bar_logo_position_entries"
            android:entryValues="@array/status_bar_logo_position_values"
            android:defaultValue="0"
            android:dependency="status_bar_logo" />

        <com.crdroid.settings.preferences.StatusBarLogoStylePreference
            android:key="status_bar_logo_style"
            android:icon="@drawable/ic_tag"
            android:title="@string/status_bar_logo_style_title"
            android:summary="@string/status_bar_logo_style_summary"
            android:dependency="status_bar_logo" />
    </PreferenceCategory>

    <!-- Icons -->
    <PreferenceCategory
        android:key="look_status_bar_icons_category"
        android:title="@string/look_status_bar_icons_category">

        <Preference
            android:key="status_bar_icons"
            android:icon="@drawable/ic_tune"
            android:title="@string/status_bar_icons_title"
            android:summary="@string/status_bar_icons_summary"
            android:fragment="com.crdroid.settings.fragments.statusbar.StatusBarIcons" />

        <Preference
            android:key="network_traffic_settings"
            android:icon="@drawable/ic_traffic"
            android:title="@string/network_traffic_settings_title"
            android:summary="@string/network_traffic_settings_summary"
            android:fragment="com.crdroid.settings.fragments.statusbar.NetworkTrafficSettings" />


        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="show_fourg_icon"
            android:icon="@drawable/ic_signal"
            android:title="@string/show_fourg_icon_title"
            android:summary="@string/show_fourg_icon_summary"
            android:defaultValue="false" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="data_disabled_icon"
            android:icon="@drawable/ic_data"
            android:title="@string/data_disabled_icon_title"
            android:summary="@string/data_disabled_icon_summary"
            android:defaultValue="false" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="bluetooth_show_battery"
            android:icon="@drawable/ic_battery_bluetooth"
            android:title="@string/bluetooth_battery_title"
            android:summary="@string/bluetooth_battery_summary"
            android:defaultValue="true"/>

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="wifi_standard_icon"
            android:icon="@drawable/ic_wifi"
            android:title="@string/wifi_standard_icon_title"
            android:summary="@string/wifi_standard_icon_summary"
            android:defaultValue="false"/>
    </PreferenceCategory>

    <!-- Notification dot (statusBar.notificationDot.* in ichthys.nix) -->
    <PreferenceCategory
        android:key="look_status_bar_notif_dot_category"
        android:title="@string/look_status_bar_notif_dot_category">

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="ichthys_notif_dot_enabled"
            android:icon="@drawable/ic_notifications"
            android:title="@string/ichthys_notif_dot_title"
            android:summary="@string/ichthys_notif_dot_summary"
            android:defaultValue="true" />

        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_notif_dot_logic"
            android:icon="@drawable/ic_notifications"
            android:title="@string/ichthys_notif_dot_logic_title"
            android:entries="@array/ichthys_notif_dot_logic_entries"
            android:entryValues="@array/ichthys_notif_dot_logic_values"
            android:summary="%s"
            android:defaultValue="0"
            android:dependency="ichthys_notif_dot_enabled" />


        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_notif_dot_color"
            android:icon="@drawable/ic_color_bucket"
            android:title="@string/ichthys_notif_dot_color_title"
            android:entries="@array/ichthys_notif_dot_color_entries"
            android:entryValues="@array/ichthys_notif_dot_color_values"
            android:summary="%s"
            android:defaultValue="0"
            android:dependency="ichthys_notif_dot_enabled" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="ichthys_notif_dot_replace_icons"
            android:icon="@drawable/ic_compact_notifications"
            android:title="@string/ichthys_notif_dot_replace_icons_title"
            android:summary="@string/ichthys_notif_dot_replace_icons_summary"
            android:defaultValue="false"
            android:dependency="ichthys_notif_dot_enabled" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="statusbar_notif_count"
            android:icon="@drawable/ic_counter"
            android:title="@string/statusbar_notif_count_title"
            android:summary="@string/statusbar_notif_count_summary"
            android:defaultValue="false" />
        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_statusbar_notif_icons"
            android:icon="@drawable/ic_counter"
            android:title="@string/ichthys_statusbar_notif_icons_title"
            android:entries="@array/ichthys_notif_icon_limit_entries"
            android:entryValues="@array/ichthys_notif_icon_limit_values"
            android:summary="%s"
            android:defaultValue="-1" />
    </PreferenceCategory>

    <!-- Indicators: everything about the camera / microphone / location / screen-cast
         indicators in one place.
           * enable_*_privacy_indicator: whether the indicator is raised at all;
           * ichthys_privacy_indicator_*: how it is drawn (statusBar.privacyIndicator.* in
             ichthys.nix);
           * location / microphone / camera / sensors_off: the matching status bar icon slots,
             which used to be the "Privacy" group of the System icons page. They are not
             persisted here: StatusBar.java mirrors the Settings.Secure "icon_blacklist" list,
             like StatusBarIcons does for the other slots. -->
    <PreferenceCategory
        android:key="look_status_bar_indicators_category"
        android:title="@string/look_status_bar_privacy_category">

        <com.crdroid.settings.preferences.SecureSettingSwitchPreference
            android:key="enable_camera_privacy_indicator"
            android:icon="@drawable/ic_camera"
            android:title="@string/mic_camera_privacy_indicator_title"
            android:summary="@string/mic_camera_privacy_indicator_summary"
            android:defaultValue="true" />

        <com.crdroid.settings.preferences.SecureSettingSwitchPreference
            android:key="enable_location_privacy_indicator"
            android:icon="@drawable/ic_map_marker"
            android:title="@string/location_privacy_indicator_title"
            android:summary="@string/location_privacy_indicator_summary"
            android:defaultValue="true" />

        <com.crdroid.settings.preferences.SecureSettingSwitchPreference
            android:key="enable_projection_privacy_indicator"
            android:icon="@drawable/ic_cast"
            android:title="@string/projection_privacy_indicator_title"
            android:summary="@string/projection_privacy_indicator_summary"
            android:defaultValue="true" />

        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_privacy_indicator_style"
            android:icon="@drawable/ic_camera"
            android:title="@string/ichthys_privacy_indicator_style_title"
            android:entries="@array/ichthys_privacy_indicator_style_entries"
            android:entryValues="@array/ichthys_privacy_indicator_style_values"
            android:summary="%s"
            android:defaultValue="0" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="ichthys_privacy_indicator_color_by_type"
            android:icon="@drawable/ic_color_bucket"
            android:title="@string/ichthys_privacy_indicator_color_by_type_title"
            android:summary="@string/ichthys_privacy_indicator_color_by_type_summary"
            android:defaultValue="false" />

        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="ichthys_privacy_indicator_ring_width"
            android:icon="@drawable/ic_camera"
            android:title="@string/ichthys_privacy_indicator_ring_width_title"
            android:defaultValue="2"
            android:max="4"
            settings:min="1"
            settings:units="@string/unit_dp" />

        <SwitchPreferenceCompat
            android:key="location"
            android:icon="@drawable/ic_map_marker"
            android:title="@string/look_status_bar_slot_location_title"
            android:persistent="false" />

        <SwitchPreferenceCompat
            android:key="microphone"
            android:icon="@drawable/ic_mic"
            android:title="@string/look_status_bar_slot_microphone_title"
            android:persistent="false" />

        <SwitchPreferenceCompat
            android:key="camera"
            android:icon="@drawable/ic_camera"
            android:title="@string/look_status_bar_slot_camera_title"
            android:persistent="false" />

        <SwitchPreferenceCompat
            android:key="sensors_off"
            android:icon="@drawable/ic_sign_caution"
            android:title="@string/look_status_bar_slot_sensors_off_title"
            android:persistent="false" />
    </PreferenceCategory>


    <!-- Spacing -->
    <PreferenceCategory
        android:key="look_status_bar_padding_category"
        android:title="@string/statusbar_extra_padding_category">

        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="statusbar_extra_padding_start"
            android:icon="@drawable/ic_align_left"
            android:title="@string/statusbar_extra_padding_start_title"
            android:defaultValue="0"
            settings:interval="1"
            settings:units="@string/unit_pixels"
            android:max="30"
            settings:min="-30" />

        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="statusbar_extra_padding_top"
            android:icon="@drawable/ic_align_top"
            android:title="@string/statusbar_extra_padding_top_title"
            android:defaultValue="0"
            settings:interval="1"
            settings:units="@string/unit_pixels"
            android:max="30"
            settings:min="-30" />

        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="statusbar_extra_padding_end"
            android:icon="@drawable/ic_align_right"
            android:title="@string/statusbar_extra_padding_end_title"
            android:defaultValue="0"
            settings:interval="1"
            settings:units="@string/unit_pixels"
            android:max="30"
            settings:min="-30" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="look_status_bar_gestures_category"
        android:title="@string/look_status_bar_gestures_category">

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="double_tap_sleep_gesture"
            android:icon="@drawable/ic_double_tap"
            android:title="@string/statusbar_doubletap_sleep_title"
            android:summary="@string/statusbar_doubletap_sleep_summary"
            android:defaultValue="true" />
        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_brightness_control"
            android:icon="@drawable/ic_brightness_auto"
            android:title="@string/status_bar_toggle_brightness_title"
            android:summary="@string/status_bar_toggle_brightness_summary"
            android:defaultValue="false" />
    </PreferenceCategory>

</PreferenceScreen>
