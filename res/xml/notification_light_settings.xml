<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        android:key="notification_lights"
        android:title="@string/notification_light_title">

    <!-- IchthysOS (a52sxq): the Galaxy A52s 5G has NO notification LED.
         /sys/class/leds/{red,green,blue} exist (PM8350 PMIC RGB block) but drive nothing -
         verified by writing full brightness to all three with no visible output. There is no
         lights HAL (lshal | grep -i light is empty) and NotificationRecord.mLight is null.
         Every preference below is therefore dead, so the whole screen is commented out.
         This also keeps these keys out of the Settings search index: lineage-sdk's default
         config_deviceLightCapabilities is 8 (LIGHTS_PULSATING_LED), so
         LightsCapabilities.blinks() returns true and NotificationLightSettings'
         getNonIndexableKeys() does NOT suppress the general/advanced/phone/app sections.
         The screen itself is already unreachable - Notifications.java removes the
         "notification_lights" entry because config_intrusiveNotificationLed is false.
         Do NOT uncomment unless porting to a device that actually has an LED.
    <lineageos.preference.SystemSettingMainSwitchPreference
        android:key="notification_light_pulse"
        android:title="@string/notification_light_enable_title" />

    <PreferenceCategory
        android:key="general_section"
        android:title="@string/notification_light_general_title">

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="notification_light_color_auto"
            android:title="@string/notification_light_automagic"
            android:dependency="notification_light_pulse"
            android:defaultValue="true" />

        <com.crdroid.settings.fragments.notifications.notificationlight.ApplicationLightPreference
            android:key="default"
            android:title="@string/notification_light_default_value"
            android:persistent="false"
            android:dependency="notification_light_pulse" />

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="notification_light_pulse_override"
            android:title="@string/notification_light_override"
            android:dependency="notification_light_pulse" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="brightness_section"
        android:title="@string/light_brightness_title"
        android:dependency="notification_light_pulse" >

        <com.crdroid.settings.fragments.notifications.notificationlight.NotificationBrightnessPreference
            android:key="notification_light_brightness_level"
            android:title="@string/notification_light_brightness_normal"
            android:dependency="notification_light_pulse" />

        <com.crdroid.settings.fragments.notifications.notificationlight.NotificationBrightnessZenPreference
            android:key="notification_light_brightness_level_zen"
            android:title="@string/notification_light_brightness_zen"
            android:dependency="notification_light_pulse" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="advanced_section"
        android:title="@string/notification_light_advanced_title">

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="notification_light_screen_on_enable"
            android:title="@string/notification_light_screen_on"
            android:dependency="notification_light_pulse" />

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="notification_light_pulse_custom_enable"
            android:title="@string/notification_light_use_custom"
            android:dependency="notification_light_pulse" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="phone_list"
        android:title="@string/notification_light_phonelist_title" >

        <com.crdroid.settings.fragments.notifications.notificationlight.ApplicationLightPreference
            android:key="missed_call"
            android:title="@string/notification_light_missed_call_title"
            android:persistent="false"
            android:dependency="notification_light_pulse_custom_enable" />

        <com.crdroid.settings.fragments.notifications.notificationlight.ApplicationLightPreference
            android:key="voicemail"
            android:title="@string/notification_light_voicemail_title"
            android:persistent="false"
            android:dependency="notification_light_pulse_custom_enable" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="applications_list"
        android:title="@string/notification_light_applist_title"
        android:dependency="notification_light_pulse_custom_enable" >

        <Preference
            android:key="custom_apps_add"
            android:title="@string/add"
            android:icon="@drawable/ic_add_24dp" />

    </PreferenceCategory>
    -->

</PreferenceScreen>
