<!-- IchthysOS > Weather: where the weather comes from and every place it shows, in one page
     (it was spread over the status bar, quick settings and lock screen pages). -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/ichthys_hub_weather_title">

    <PreferenceCategory
        android:key="weather_source_category"
        android:title="@string/weather_source_category">

        <Preference
            android:key="lockscreen_weather_settings"
            android:icon="@drawable/ic_weather_settings"
            android:title="@string/weather_settings_title"
            android:summary="@string/weather_settings_summary">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="org.omnirom.omnijaws"
                android:targetClass="org.omnirom.omnijaws.SettingsActivity" />
        </Preference>
        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="lockscreen_weather_enabled"
            android:icon="@drawable/ic_weather"
            android:title="@string/lockscreen_weather_title"
            android:summary="@string/lockscreen_weather_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="weather_where_category"
        android:title="@string/weather_where_category">

        <!-- Status bar weather (OmniJaws) -->
        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="status_bar_weather"
            android:icon="@drawable/ic_weather"
            android:title="@string/status_bar_weather_title"
            android:summary="%s"
            android:entries="@array/status_bar_weather_entries"
            android:entryValues="@array/status_bar_weather_values"
            android:defaultValue="0" />
        <!-- statusBar.weather.anchorToCutout in ichthys.nix -->
        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="ichthys_statusbar_weather_anchor_cutout"
            android:icon="@drawable/ic_weather"
            android:title="@string/ichthys_weather_anchor_cutout_title"
            android:summary="@string/ichthys_weather_anchor_cutout_summary"
            android:defaultValue="true" />
        <!-- Docked media player of the Shoal panel style: the strip above the footer buttons.
             Backend: Settings.Secure, observed by SystemUI ShoalMediaDock.kt. The options are
             hand-written in IchthysOptions (quickSettings.mediaDock.*). -->
        <com.crdroid.settings.preferences.SecureSettingSwitchPreference
            android:key="ichthys_qs_header_weather"
            android:icon="@drawable/ic_weather"
            android:title="@string/ichthys_qs_header_weather_title"
            android:summary="@string/ichthys_qs_header_weather_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="weather_lockscreen_category"
        android:title="@string/weather_lockscreen_category">

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="lockscreen_weather_location"
            android:icon="@drawable/ic_map_marker"
            android:title="@string/lockscreen_weather_location_title"
            android:summary="@string/lockscreen_weather_location_summary"
            android:dependency="lockscreen_weather_enabled" />
        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="lockscreen_weather_text"
            android:icon="@drawable/ic_weather_condition"
            android:title="@string/lockscreen_weather_text_title"
            android:summary="@string/lockscreen_weather_text_summary"
            android:defaultValue="true"
            android:dependency="lockscreen_weather_enabled" />
        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="lockscreen_weather_wind_info"
            android:icon="@drawable/ic_weather_windy"
            android:title="@string/lockscreen_weather_wind_info_title"
            android:summary="@string/lockscreen_weather_wind_info_summary"
            android:defaultValue="false"
            android:dependency="lockscreen_weather_enabled" />
        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="lockscreen_weather_humidity_info"
            android:icon="@drawable/ic_water_percent"
            android:title="@string/lockscreen_weather_humidity_info_title"
            android:summary="@string/lockscreen_weather_humidity_info_summary"
            android:defaultValue="false"
            android:dependency="lockscreen_weather_enabled" />
    </PreferenceCategory>

</PreferenceScreen>
