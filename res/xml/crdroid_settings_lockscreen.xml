<!-- Look > Lock screen > Lock screen and ambient display: what the lock screen and the ambient
     display show. The clock face and the fingerprint page are next to this page in Theme Studio;
     the lock screen gesture is in System > Buttons & gestures (crdroid_settings_button.xml), the
     lock screen / always-on notification limits in System > Notifications
     (crdroid_settings_notifications.xml), and the fingerprint vibration and ripple switches on
     the fingerprint page (fingerprint_effects.xml).

     This file is the "lockscreen" page for
     frameworks/base/tools/ichthys-config/gen_crdroid_options.py. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    xmlns:lineage="http://schemas.android.com/apk/res-auto"
    android:title="@string/ichthys_hub_lockscreen_title">

    <!-- The lock screen editor (tracker#58): looks, the clock, depth, wallpaper. -->
    <Preference
        android:key="ichthys_lockscreen_editor"
        android:icon="@drawable/ic_lock_clock"
        android:title="@string/ichthys_editor_open"
        android:summary="@string/ichthys_editor_summary">
        <intent
            android:targetPackage="com.android.settings"
            android:targetClass="com.crdroid.settings.fragments.lockscreen.LockscreenEditorActivity" />
    </Preference>
    <!-- The one fingerprint page: icon and animation packs, press effects, pressed icon,
         idle icon, result effects, haptics, ripple. -->
    <Preference
        android:key="ichthys_fingerprint_effects"
        android:icon="@drawable/ic_fp_selector"
        android:title="@string/look_fingerprint_title"
        android:summary="@string/look_fingerprint_summary"
        android:fragment="com.crdroid.settings.fragments.lockscreen.FingerprintEffects" />

    <PreferenceCategory
        android:key="lockscreen_interface_category"
        android:title="@string/weather_lockscreen_category">

        <!-- Pulse music visualizer. SystemUI backend ported to A17 under
             frameworks/base packages/SystemUI src/com/android/systemui/pulse. -->
        <Preference
            android:key="pulse_settings"
            android:icon="@drawable/ic_pulse"
            android:title="@string/pulse_settings_title"
            android:summary="@string/pulse_settings_summary"
            android:fragment="com.crdroid.settings.fragments.lockscreen.PulseSettings" />

        <Preference
            android:key="media_art_settings"
            android:icon="@drawable/ic_movie"
            android:title="@string/ls_media_art_title"
            android:summary="@string/ls_media_art_summary"
            android:fragment="com.crdroid.settings.fragments.lockscreen.MediaArtSettings" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="lockscreen_battery_info"
            android:icon="@drawable/ic_battery_charging"
            android:title="@string/lockscreen_battery_info_title"
            android:summary="@string/lockscreen_battery_info_summary"
            android:defaultValue="true" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="lockscreen_enable_power_menu"
            android:icon="@drawable/ic_power"
            android:title="@string/lockscreen_enable_power_menu_title"
            android:summary="@string/lockscreen_enable_power_menu_summary"
            android:defaultValue="true" />

        <com.crdroid.settings.preferences.SecureSettingSwitchPreference
            android:key="ichthys_lockscreen_hide_statusbar"
            android:icon="@drawable/ic_tune"
            android:title="@string/ichthys_lockscreen_hide_statusbar_title"
            android:summary="@string/ichthys_lockscreen_hide_statusbar_summary"
            android:defaultValue="false" />

            <com.crdroid.settings.preferences.SystemSettingListPreference
                android:key="ichthys_lockscreen_max_notifs"
                android:icon="@drawable/ic_counter"
                android:title="@string/ichthys_lockscreen_max_notifs_title"
                android:entries="@array/ichthys_lockscreen_max_notifs_entries"
                android:entryValues="@array/ichthys_lockscreen_max_notifs_values"
                android:summary="%s"
                android:defaultValue="-1" />
        <com.crdroid.settings.preferences.SecureSettingSwitchPreference
            android:key="notification_row_transparency_lockscreen"
            android:icon="@drawable/ic_chat_dashed"
            android:title="@string/notification_row_transparency_lockscreen_title"
            android:summary="@string/notification_row_transparency_lockscreen_summary"
            android:defaultValue="true" />
            <com.crdroid.settings.preferences.SecureSettingSwitchPreference
                android:key="enable_lockscreen_quick_settings"
                android:icon="@drawable/ic_lock_alert"
                android:title="@string/lockscreen_quick_settings_title"
                android:summary="@string/lockscreen_quick_settings_summary"
                android:defaultValue="true" />
            <com.crdroid.settings.preferences.SystemSettingSwitchPreference
                android:key="double_tap_sleep_lockscreen"
                android:icon="@drawable/ic_double_tap"
                android:title="@string/lockscreen_doubletap_sleep_title"
                android:summary="@string/lockscreen_doubletap_sleep_summary"
                android:defaultValue="true" />
    </PreferenceCategory>


    <PreferenceCategory
        android:key="lockscreen_ambient_category"
        android:title="@string/ichthys_aod_category">

        <!-- Ambient display: schedule, wake gestures, ambient wallpaper. The on / always-on /
             pick-up switches themselves are stock (Display > Lock screen). -->
        <Preference
            android:key="doze_fragment"
            android:icon="@drawable/ic_ambient"
            android:title="@string/doze_display_title"
            android:summary="@string/doze_display_summary"
            android:fragment="com.crdroid.settings.fragments.ui.DozeSettings" />

        <!-- Edge Light -->
        <Preference
            android:key="edge_light_settings"
            android:icon="@drawable/ic_edge_light"
            android:title="@string/edge_light_title"
            android:summary="@string/edge_light_summary"
            android:fragment="com.crdroid.settings.fragments.ui.EdgeLightSettings" />

        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_aod_notif_icons"
            android:icon="@drawable/ic_counter"
            android:title="@string/ichthys_aod_notif_icons_title"
            android:entries="@array/ichthys_aod_notif_icons_entries"
            android:entryValues="@array/ichthys_aod_notif_icons_values"
            android:summary="%s"
            android:defaultValue="-1" />
    </PreferenceCategory>

</PreferenceScreen>
