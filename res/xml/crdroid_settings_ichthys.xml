     crDroid-inherited features live in their own tabs; only fully-custom
     additions belong here.
-->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings">

    <!-- Global disable-all-vibration master toggle -->
    <com.crdroid.settings.preferences.SystemSettingSwitchPreference
        android:key="disable_all_vibration"
        android:icon="@drawable/ic_vibrate"
        android:title="@string/disable_all_vibration_title"
        android:summary="@string/disable_all_vibration_summary"
        android:defaultValue="false" />

    <!-- Pitch black theme moved to Themes > Global theme
         (com.crdroid.settings.fragments.themes.ThemeGlobal). -->

    <PreferenceCategory
        android:key="ichthys_recents_category"
        android:title="@string/ichthys_recents_category">

        <!-- Recents implementation selector -->
        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="recents_type"
            android:icon="@drawable/ic_sysbar_recent"
            android:title="@string/recents_type_title"
            android:summary="%s"
            android:entries="@array/recents_type_entries"
            android:entryValues="@array/recents_type_values"
            android:defaultValue="0" />

        <!-- Slim Recents tuning (only relevant when recents_type = Slim) -->
        <Preference
            android:key="slim_recents_settings"
            android:icon="@drawable/ic_memory"
            android:title="@string/slim_recents_title"
            android:summary="@string/slim_recents_summary"
            android:fragment="com.crdroid.settings.fragments.recents.SlimRecents" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="ichthys_volume_category"
        android:title="@string/ichthys_volume_category">

        <!-- Horizontal (8.1-style) volume slider -->
        <com.crdroid.settings.preferences.SecureSettingSwitchPreference
            android:key="custom_volume_horizontal"
            android:icon="@drawable/ic_sliders"
            android:title="@string/custom_volume_horizontal_title"
            android:summary="@string/custom_volume_horizontal_summary"
            android:defaultValue="false" />

        <!-- Media volume steps (needs a reboot to take effect) -->
        <com.crdroid.settings.preferences.SecureSettingSeekBarPreference
            android:key="custom_volume_steps"
            android:icon="@drawable/ic_volume_vibrate"
            android:title="@string/custom_volume_steps_title"
            android:summary="@string/custom_volume_steps_summary"
            android:max="200"
            settings:min="5"
            android:defaultValue="200" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="ichthys_battery_category"
        android:title="@string/ichthys_battery_category">

        <!-- Charging control (charge limit / smart charging). Backed by
             vendor.lineage.health.IChargingControl -> batt_slate_mode. IchthysOS.java removes
             this entry when HealthInterface reports the feature unsupported. -->
        <Preference
            android:key="charging_control"
            android:icon="@drawable/ic_battery_charging_full"
            android:title="@string/charging_control_title"
            android:summary="@string/charging_control_summary"
            android:fragment="com.crdroid.settings.fragments.health.ChargingControlSettings" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="ichthys_privacy_category"
        android:title="@string/ichthys_privacy_category">

        <!-- Global contacts lockdown. Enforced in two places: PermissionController strips the
             request before a dialog is ever built (ContactsLockdown) and sweeps apps that already
             hold the permission (ContactsLockdownReceiver), while ContactsLockdownPolicy in
             system_server refuses the grant itself so nothing outside can work around it.
             IchthysOS.java asks for that sweep when this is switched on. -->
        <com.crdroid.settings.preferences.GlobalSettingSwitchPreference
            android:key="ichthys_contacts_lockdown"
            android:icon="@drawable/ic_account_circle"
            android:title="@string/contacts_lockdown_title"
            android:summary="@string/contacts_lockdown_summary"
            android:defaultValue="true" />

        <!-- Backstage: apps kept "in the foreground" on a hidden display
             (IchthysBackstageService, kusti420/ichthysos-tracker#38). -->
        <Preference
            android:key="ichthys_backstage"
            android:icon="@drawable/ic_screensaver"
            android:title="@string/backstage_title"
            android:summary="@string/backstage_summary"
            android:fragment="com.crdroid.settings.fragments.backstage.Backstage" />

        <!-- Clipboard lockdown. Enforced in ClipboardService: apps only read clip contents
             right after a verified user tap/keypress (e.g. Paste); the keyboard, SystemUI and
             the copying app itself are exempt. Clips also auto-clear after a few minutes. -->
        <com.crdroid.settings.preferences.GlobalSettingSwitchPreference
            android:key="ichthys_clipboard_lockdown"
            android:icon="@drawable/ic_content_copy"
            android:title="@string/clipboard_lockdown_title"
            android:summary="@string/clipboard_lockdown_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="ichthys_statusbar_category"
        android:title="@string/ichthys_statusbar_category">

        <!-- Status bar weather (OmniJaws) -->
        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="status_bar_weather"
            android:icon="@drawable/ic_weather"
            android:title="@string/status_bar_weather_title"
            android:summary="%s"
            android:entries="@array/status_bar_weather_entries"
            android:entryValues="@array/status_bar_weather_values"
            android:defaultValue="0" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="ichthys_security_category"
        android:title="@string/ichthys_security_category">

        <!-- Duress / emergency wipe credential. Enforcement lives in LockSettingsService;
             this entry only leads to the screen that sets it. -->
        <Preference
            android:key="duress_credential"
            android:icon="@drawable/ic_lock_alert"
            android:title="@string/duress_credential_title"
            android:summary="@string/duress_credential_summary"
            settings:keywords="@string/duress_credential_keywords"
            android:fragment="com.crdroid.settings.fragments.security.DuressCredentialSettings" />

    </PreferenceCategory>

</PreferenceScreen>
