<!-- Look > Lock screen > Fingerprint: the one page for the fingerprint (UDFPS) sensor's look and
     feedback. SystemUI reads the ichthys_udfps_* keys on each touch (IchthysUdfpsSettings); the
     idle icon updates live.

     The crDroid icon and animation packs are picked here too (UdfpsPackPreference, a dialog),
     where they used to be two pages of their own; FingerprintEffects.java removes a picker
     whose pack is not installed. fp_success_vibrate, fp_error_vibrate and enable_ripple_effect
     came from the old Lock screen tab and keep the option paths they had there (lockscreen.*)
     through crdroid_paths.lock of frameworks/base/tools/ichthys-config/gen_crdroid_options.py. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/look_fingerprint_title">

    <PreferenceCategory
        android:key="ichthys_fp_press_category"
        android:title="@string/ichthys_fp_press_category">

        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_udfps_anim_effect"
            android:title="@string/ichthys_fp_anim_effect_title"
            android:summary="%s"
            android:entries="@array/ichthys_fp_anim_effect_entries"
            android:entryValues="@array/ichthys_fp_anim_effect_values"
            android:defaultValue="4" />

        <!-- Which animation of the pack plays; used by the "Animation pack" effect. -->
        <com.crdroid.settings.preferences.UdfpsPackPreference
            android:key="udfps_anim_style"
            android:title="@string/look_fp_pack_animation_title"
            android:persistent="false" />

        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="ichthys_udfps_anim_speed"
            android:title="@string/ichthys_fp_anim_speed_title"
            android:defaultValue="100"
            android:max="300"
            settings:min="25"
            settings:interval="5"
            settings:units="@string/unit_percent" />

        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="ichthys_udfps_anim_scale"
            android:title="@string/ichthys_fp_anim_scale_title"
            android:defaultValue="100"
            android:max="250"
            settings:min="50"
            settings:interval="5"
            settings:units="@string/unit_percent" />

        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_udfps_anim_color_mode"
            android:title="@string/ichthys_fp_anim_color_mode_title"
            android:summary="%s"
            android:entries="@array/ichthys_fp_anim_color_mode_entries"
            android:entryValues="@array/ichthys_fp_anim_color_mode_values"
            android:defaultValue="0" />

        <com.crdroid.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="ichthys_udfps_anim_color"
            android:title="@string/ichthys_fp_custom_color_title"
            settings:accentDefault="true" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="ichthys_udfps_anim_bp"
            android:title="@string/ichthys_fp_anim_bp_title"
            android:summary="@string/ichthys_fp_anim_bp_summary"
            android:defaultValue="true" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="ichthys_udfps_anim_enroll"
            android:title="@string/ichthys_fp_anim_enroll_title"
            android:summary="@string/ichthys_fp_anim_enroll_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="ichthys_fp_pressed_category"
        android:title="@string/ichthys_fp_pressed_category">

        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_udfps_pressed_style"
            android:title="@string/ichthys_fp_pressed_style_title"
            android:summary="%s"
            android:entries="@array/ichthys_fp_pressed_style_entries"
            android:entryValues="@array/ichthys_fp_pressed_style_values"
            android:defaultValue="0" />

        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_udfps_pressed_color_mode"
            android:title="@string/ichthys_fp_color_mode_title"
            android:summary="%s"
            android:entries="@array/ichthys_fp_color_mode3_entries"
            android:entryValues="@array/ichthys_fp_color_mode3_values"
            android:defaultValue="0" />

        <com.crdroid.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="ichthys_udfps_pressed_color"
            android:title="@string/ichthys_fp_custom_color_title"
            settings:accentDefault="true" />

        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="ichthys_udfps_pressed_size"
            android:title="@string/ichthys_fp_pressed_size_title"
            android:defaultValue="120"
            android:max="200"
            settings:min="100"
            settings:interval="5"
            settings:units="@string/unit_percent" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="ichthys_fp_icon_category"
        android:title="@string/ichthys_fp_icon_category">

        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_udfps_icon_style"
            android:title="@string/ichthys_fp_icon_style_title"
            android:summary="%s"
            android:entries="@array/ichthys_fp_icon_style_entries"
            android:entryValues="@array/ichthys_fp_icon_style_values"
            android:defaultValue="8" />

        <!-- Which icon of the pack shows; used by the "System" icon style. -->
        <com.crdroid.settings.preferences.UdfpsPackPreference
            android:key="udfps_icon"
            android:title="@string/look_fp_pack_icon_title"
            android:persistent="false" />

        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_udfps_icon_color_mode"
            android:title="@string/ichthys_fp_color_mode_title"
            android:summary="%s"
            android:entries="@array/ichthys_fp_icon_color_mode_entries"
            android:entryValues="@array/ichthys_fp_icon_color_mode_values"
            android:defaultValue="0" />

        <com.crdroid.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="ichthys_udfps_icon_color"
            android:title="@string/ichthys_fp_custom_color_title"
            android:defaultValue="0xffffffff" />

        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="ichthys_udfps_icon_opacity"
            android:title="@string/ichthys_fp_icon_opacity_title"
            android:defaultValue="100"
            android:max="100"
            settings:min="10"
            settings:interval="5"
            settings:units="@string/unit_percent" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="ichthys_udfps_icon_aod"
            android:title="@string/ichthys_fp_icon_aod_title"
            android:summary="@string/ichthys_fp_icon_aod_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="ichthys_fp_result_category"
        android:title="@string/ichthys_fp_result_category">

        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_udfps_success_effect"
            android:title="@string/ichthys_fp_success_effect_title"
            android:summary="%s"
            android:entries="@array/ichthys_fp_success_effect_entries"
            android:entryValues="@array/ichthys_fp_success_effect_values"
            android:defaultValue="1" />

        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_udfps_fail_effect"
            android:title="@string/ichthys_fp_fail_effect_title"
            android:summary="%s"
            android:entries="@array/ichthys_fp_fail_effect_entries"
            android:entryValues="@array/ichthys_fp_fail_effect_values"
            android:defaultValue="2" />

        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_udfps_haptic_success"
            android:title="@string/ichthys_fp_haptic_success_title"
            android:summary="%s"
            android:entries="@array/ichthys_fp_haptic_success_entries"
            android:entryValues="@array/ichthys_fp_haptic_values"
            android:defaultValue="0" />

        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_udfps_haptic_error"
            android:title="@string/ichthys_fp_haptic_error_title"
            android:summary="%s"
            android:entries="@array/ichthys_fp_haptic_error_entries"
            android:entryValues="@array/ichthys_fp_haptic_values"
            android:defaultValue="0" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="fp_success_vibrate"
            android:title="@string/fp_success_vibrate_title"
            android:summary="@string/fp_success_vibrate_summary"
            android:defaultValue="true" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="fp_error_vibrate"
            android:title="@string/fp_error_vibrate_title"
            android:summary="@string/fp_error_vibrate_summary"
            android:defaultValue="true" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="enable_ripple_effect"
            android:title="@string/enable_fingerprint_ripple_effect_title"
            android:summary="@string/enable_fingerprint_ripple_effect_summary"
            android:defaultValue="true" />

    </PreferenceCategory>
</PreferenceScreen>
