<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/backstage_title">

    <Preference
        android:key="backstage_intro"
        android:summary="@string/backstage_intro"
        android:selectable="false" />

    <com.crdroid.settings.preferences.SecureSettingListPreference
        android:key="ichthys_backstage_max_hours"
        android:title="@string/backstage_max_hours_title"
        android:summary="%s"
        android:entries="@array/backstage_max_hours_entries"
        android:entryValues="@array/backstage_max_hours_values"
        android:defaultValue="0" />

    <PreferenceCategory
        android:key="backstage_apps"
        android:title="@string/backstage_apps_category" />

</PreferenceScreen>
