<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:lineage="http://schemas.android.com/apk/res-auto"
    android:key="button_settings"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings">

    <!-- IchthysOS (a52sxq): the Galaxy A52s 5G has NO capacitive keys and NO camera key - it is
         an all-screen phone. "dumpsys input" reports zero devices exposing KEY_HOME /
         KEY_APPSELECT / KEY_CAMERA, there is no config_deviceHardwareKeys override under
         device/samsung (so lineage-sdk's default of 64 = KEY_MASK_VOLUME only applies), and
         there is no device KeyHandler. Anything genuinely bound to that missing hardware stays
         commented out below.

         The ON-SCREEN navigation buttons are a different story and ARE bound: the home and
         recents long-press / double-tap actions are live, consumed by
         packages/apps/Launcher3/.../taskbar/TaskbarNavButtonController.java (on this build the
         3-button navbar is the Launcher taskbar, and its buttons dispatch by direct method call
         rather than by key event, so PhoneWindowManager never sees them - see the block comment
         in that file). Those four preferences use navbar_keys_action_entries/values, which is
         hardware_keys_action_entries filtered down to what the launcher process can actually do.

         Back long-press is deliberately NOT offered: the back button uses a bespoke touch
         listener feeding the predictive-back animation, and binding its long press races that.

         Note also that Buttons.java calls findPreference()/removePreference() for many of these
         keys. It is now null-safe (see removePref() there), so commenting a preference out here
         no longer risks an NPE - but the empty <PreferenceCategory> shells are still kept for
         clarity and because Buttons.java removes them by key at runtime. -->
    <PreferenceCategory
        android:key="extras_category"
        android:title="@string/extras_title" >

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="hardware_keys_disable"
            android:icon="@drawable/ic_buttons"
            android:title="@string/hwkeys_disabled_title"
            android:summary="@string/hwkeys_disabled_summary" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="swap_capacitive_keys"
            android:icon="@drawable/ic_buttons"
            android:title="@string/swap_capacitive_keys_title"
            android:summary="@string/swap_capacitive_keys_summary" />

        <lineageos.preference.RemotePreference
            android:key="additional_buttons"
            android:icon="@drawable/ic_extra_buttons"
            android:title="@string/additional_buttons_title"
            lineage:requiresAction="org.lineageos.settings.device.ADDITIONAL_BUTTONS_SETTINGS">
            <intent
                 android:action="org.lineageos.settings.device.ADDITIONAL_BUTTONS_SETTINGS" />
        </lineageos.preference.RemotePreference>

        <!-- No capacitive or camera keys on a52sxq. Despite its generic name this toggle is not a
             standalone screenshot feature: in crDroid it only changes what a *hardware key
             long-press* action does (partial vs full screenshot), so it is dead here for the same
             reason as the rest. It is also the only one of these that Buttons.java leaves visible
             and searchable on this device (it is only removed / marked non-indexable when the
             device has no volume keys, and the A52s does have them), so it has to be hidden here.
        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="click_partial_screenshot"
            android:icon="@drawable/ic_screenshot"
            android:title="@string/click_partial_screenshot_title"
            android:summary="@string/click_partial_screenshot_summary"
            android:defaultValue="false" />
        -->

        <com.crdroid.settings.fragments.buttons.ButtonBacklightBrightness
            android:key="button_backlight"
            android:icon="@drawable/ic_backlight"
            android:title="@string/button_backlight_title"
            android:summary="@string/button_backlight_summary"
            android:dialogTitle="@string/button_backlight_title"
            android:persistent="false" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="anbi_enabled"
            android:icon="@drawable/ic_anbi"
            android:title="@string/anbi_title"
            android:summary="@string/anbi_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="power_key"
        android:title="@string/hardware_keys_power_key_title" >

        <Preference
            android:key="power_menu"
            android:icon="@drawable/ic_settings_powermenu"
            android:title="@string/power_menu_title"
            android:summary="@string/power_menu_summary"
            android:fragment="com.crdroid.settings.fragments.buttons.PowerMenuActions" />

        <SwitchPreferenceCompat
            android:key="power_end_call"
            android:icon="@drawable/ic_end_call"
            android:title="@string/power_end_call_title"
            android:summary="@string/power_end_call_summary"
            android:persistent="false"/>

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="torch_long_press_power_gesture"
            android:icon="@drawable/ic_flashlight"
            android:title="@string/torch_long_press_power_gesture_title"
            android:summary="@string/torch_long_press_power_gesture_desc"
            android:defaultValue="false"
            lineage:requiresConfig="@*android:bool/config_supportLongPressPowerWhenNonInteractive" />

        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="torch_long_press_power_timeout"
            android:icon="@drawable/ic_timer_outline"
            android:title="@string/torch_long_press_power_timeout_title"
            android:defaultValue="0"
            android:dependency="torch_long_press_power_gesture"
            settings:defaultValueText="@string/never"
            android:max="600"
            settings:min="0"
            settings:interval="10"
            settings:units="@string/unit_seconds"
            lineage:requiresConfig="@*android:bool/config_supportLongPressPowerWhenNonInteractive" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="home_key"
        android:title="@string/hardware_keys_home_key_title" >

        <!-- Wake-on-home and answer-call-with-home need a physical home key, which a52sxq
             does not have.
        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="home_wake_screen"
            android:icon="@drawable/ic_wake"
            android:title="@string/button_wake_title"
            android:summary="@string/button_wake_summary"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="home_answer_call"
            android:icon="@drawable/ic_answer_call"
            android:title="@string/home_answer_call_title"
            android:summary="@string/home_answer_call_summary"
            android:persistent="false"/>
        -->

        <!-- Live: on-screen home button, handled by TaskbarNavButtonController. -->
        <ListPreference
            android:key="hardware_keys_home_long_press"
            android:icon="@drawable/ic_single_tap"
            android:dialogTitle="@string/hardware_keys_long_press_title"
            android:title="@string/hardware_keys_long_press_title"
            android:entries="@array/navbar_keys_action_entries"
            android:entryValues="@array/navbar_keys_action_values"
            android:persistent="false" />

        <ListPreference
            android:key="hardware_keys_home_double_tap"
            android:icon="@drawable/ic_double_tap"
            android:dialogTitle="@string/hardware_keys_double_tap_title"
            android:title="@string/hardware_keys_double_tap_title"
            android:entries="@array/navbar_keys_action_entries"
            android:entryValues="@array/navbar_keys_action_values"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="back_key"
        android:title="@string/hardware_keys_back_key_title" >

        <!-- No capacitive back key on a52sxq (see note at top of file). The empty category
             shell is kept; Buttons.java removes it by key at runtime.
        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="back_wake_screen"
            android:icon="@drawable/ic_wake"
            android:title="@string/button_wake_title"
            android:summary="@string/button_wake_summary"
            android:defaultValue="false" />

        <ListPreference
            android:key="hardware_keys_back_long_press"
            android:icon="@drawable/ic_single_tap"
            android:dialogTitle="@string/hardware_keys_long_press_title"
            android:title="@string/hardware_keys_long_press_title"
            android:entries="@array/hardware_keys_action_entries"
            android:entryValues="@array/hardware_keys_action_values"
            android:persistent="false" />
        -->

        <!--<ListPreference
            android:key="hardware_keys_back_double_tap"
            android:icon="@drawable/ic_double_tap"
            android:dialogTitle="@string/hardware_keys_double_tap_title"
            android:title="@string/hardware_keys_double_tap_title"
            android:entries="@array/hardware_keys_action_entries"
            android:entryValues="@array/hardware_keys_action_values"
            android:persistent="false" />-->
    </PreferenceCategory>

    <PreferenceCategory
        android:key="menu_key"
        android:title="@string/hardware_keys_menu_key_title" >

        <!-- No capacitive menu key on a52sxq (see note at top of file). The empty category
             shell is kept; Buttons.java removes it by key at runtime.
        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="menu_wake_screen"
            android:icon="@drawable/ic_wake"
            android:title="@string/button_wake_title"
            android:summary="@string/button_wake_summary"
            android:defaultValue="false" />

        <ListPreference
            android:key="hardware_keys_menu_press"
            android:icon="@drawable/ic_single_tap"
            android:dialogTitle="@string/hardware_keys_short_press_title"
            android:title="@string/hardware_keys_short_press_title"
            android:entries="@array/hardware_keys_action_entries"
            android:entryValues="@array/hardware_keys_action_values"
            android:persistent="false" />

        <ListPreference
            android:key="hardware_keys_menu_long_press"
            android:icon="@drawable/ic_single_tap"
            android:dialogTitle="@string/hardware_keys_long_press_title"
            android:title="@string/hardware_keys_long_press_title"
            android:entries="@array/hardware_keys_action_entries"
            android:entryValues="@array/hardware_keys_action_values"
            android:persistent="false" />
        -->
    </PreferenceCategory>

    <PreferenceCategory
        android:key="assist_key"
        android:title="@string/hardware_keys_assist_key_title" >

        <!-- No capacitive assist key on a52sxq (see note at top of file). The empty category
             shell is kept; Buttons.java removes it by key at runtime.
        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="assist_wake_screen"
            android:icon="@drawable/ic_wake"
            android:title="@string/button_wake_title"
            android:summary="@string/button_wake_summary"
            android:defaultValue="false" />

        <ListPreference
            android:key="hardware_keys_assist_press"
            android:icon="@drawable/ic_single_tap"
            android:dialogTitle="@string/hardware_keys_short_press_title"
            android:title="@string/hardware_keys_short_press_title"
            android:entries="@array/hardware_keys_action_entries"
            android:entryValues="@array/hardware_keys_action_values"
            android:persistent="false" />

        <ListPreference
            android:key="hardware_keys_assist_long_press"
            android:icon="@drawable/ic_single_tap"
            android:dialogTitle="@string/hardware_keys_long_press_title"
            android:title="@string/hardware_keys_long_press_title"
            android:entries="@array/hardware_keys_action_entries"
            android:entryValues="@array/hardware_keys_action_values"
            android:persistent="false" />
        -->

        <!--<ListPreference
            android:key="hardware_keys_assist_double_tap"
            android:icon="@drawable/ic_double_tap"
            android:dialogTitle="@string/hardware_keys_double_tap_title"
            android:title="@string/hardware_keys_double_tap_title"
            android:entries="@array/hardware_keys_action_entries"
            android:entryValues="@array/hardware_keys_action_values"
            android:persistent="false" />-->
    </PreferenceCategory>

    <PreferenceCategory
        android:key="app_switch_key"
        android:title="@string/hardware_keys_appswitch_key_title" >

        <!-- Wake-on-recents needs a physical key. And the recents SHORT press stays hard-wired
             to "open recents": rebinding it is the one setting that can leave a user with no way
             back to the task switcher, and nothing else on screen replaces it.
        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="app_switch_wake_screen"
            android:icon="@drawable/ic_wake"
            android:title="@string/button_wake_title"
            android:summary="@string/button_wake_summary"
            android:defaultValue="false" />

        <ListPreference
            android:key="hardware_keys_app_switch_press"
            android:icon="@drawable/ic_single_tap"
            android:dialogTitle="@string/hardware_keys_short_press_title"
            android:title="@string/hardware_keys_short_press_title"
            android:entries="@array/hardware_keys_action_entries"
            android:entryValues="@array/hardware_keys_action_values"
            android:persistent="false" />
        -->

        <!-- Live: on-screen recents button, handled by TaskbarNavButtonController. The
             back+recents long-press screen-unpin combo keeps priority over the long-press
             action while an app is pinned. -->
        <ListPreference
            android:key="hardware_keys_app_switch_long_press"
            android:icon="@drawable/ic_single_tap"
            android:dialogTitle="@string/hardware_keys_long_press_title"
            android:title="@string/hardware_keys_long_press_title"
            android:entries="@array/navbar_keys_action_entries"
            android:entryValues="@array/navbar_keys_action_values"
            android:persistent="false" />

        <ListPreference
            android:key="hardware_keys_app_switch_double_tap"
            android:icon="@drawable/ic_double_tap"
            android:dialogTitle="@string/hardware_keys_double_tap_title"
            android:title="@string/hardware_keys_double_tap_title"
            android:entries="@array/navbar_keys_action_entries"
            android:entryValues="@array/navbar_keys_action_values"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="camera_key"
        android:title="@string/hardware_keys_camera_key_title">

        <!-- No dedicated camera key on a52sxq (see note at top of file). The empty category
             shell is kept; Buttons.java removes it by key at runtime.
        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="camera_wake_screen"
            android:icon="@drawable/ic_wake"
            android:title="@string/button_wake_title"
            android:summary="@string/button_wake_summary"
            android:defaultValue="false" />

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="camera_sleep_on_release"
            android:icon="@drawable/ic_camera_rear"
            android:title="@string/camera_sleep_on_release_title"
            android:summary="@string/camera_sleep_on_release_summary"
            android:defaultValue="false" />

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="camera_launch"
            android:icon="@drawable/ic_camera"
            android:title="@string/camera_launch_title"
            android:summary="@string/camera_launch_summary"
            android:defaultValue="false" />
        -->
    </PreferenceCategory>

    <PreferenceCategory
        android:key="volume_keys"
        android:title="@string/hardware_keys_volume_keys_title" >

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="volume_wake_screen"
            android:icon="@drawable/ic_wake"
            android:title="@string/button_wake_title"
            android:summary="@string/button_wake_summary"
            android:defaultValue="false" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="volume_answer_call"
            android:icon="@drawable/ic_answer_call"
            android:title="@string/volume_answer_call_title"
            android:summary="@string/volume_answer_call_summary"
            android:defaultValue="false" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="volbtn_music_controls"
            android:icon="@drawable/ic_music"
            android:title="@string/volbtn_music_controls_title"
            android:summary="@string/volbtn_music_controls_summary"
            android:defaultValue="true" />

        <!-- Also seek while the screen is ON (not just off) -->
        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="volume_music_controls_screen_on"
            android:icon="@drawable/ic_music"
            android:title="@string/volume_music_controls_screen_on_title"
            android:summary="@string/volume_music_controls_screen_on_summary"
            android:defaultValue="false"
            android:dependency="volbtn_music_controls" />

        <!-- One step per press: holding a volume key won't keep changing volume -->
        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="volume_key_one_step"
            android:icon="@drawable/ic_music"
            android:title="@string/volume_key_one_step_title"
            android:summary="@string/volume_key_one_step_summary"
            android:defaultValue="false"
            android:dependency="volbtn_music_controls" />

        <ListPreference
            android:key="volume_key_cursor_control"
            android:icon="@drawable/ic_cursor"
            android:dialogTitle="@string/volbtn_cursor_control_title"
            android:title="@string/volbtn_cursor_control_title"
            android:entries="@array/volbtn_cursor_control_entries"
            android:entryValues="@array/volbtn_cursor_control_values"
            android:persistent="false" />

        <SwitchPreferenceCompat
            android:key="swap_volume_buttons"
            android:icon="@drawable/ic_rotation"
            android:title="@string/swap_volume_buttons_title"
            android:summary="@string/swap_volume_buttons_summary" />
    </PreferenceCategory>
</PreferenceScreen>
