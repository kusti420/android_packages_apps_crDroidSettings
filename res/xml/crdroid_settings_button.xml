<!-- IchthysOS > System > Buttons & gestures: the physical buttons, the on-screen navigation
     buttons, gesture navigation and the screen / status bar / lock screen gestures.

     Hardware. The Galaxy A52s 5G (a52sxq) has power and volume keys only: no capacitive keys, no
     camera key (config_deviceHardwareKeys is 64, KEY_MASK_VOLUME) and no device KeyHandler, so
     nothing that needs such a key is offered here.

     The ON-SCREEN navigation buttons are a different story and ARE bound: the home and recents
     long-press / double-tap actions are live, consumed by
     packages/apps/Launcher3/.../taskbar/TaskbarNavButtonController.java (on this build the
     3-button navbar is the Launcher taskbar, and its buttons dispatch by direct method call
     rather than by key event, so PhoneWindowManager never sees them - see the block comment in
     that file). Those four preferences use navbar_keys_action_entries/values, which is
     hardware_keys_action_entries filtered down to what the launcher process can actually do.
     Back long-press is deliberately NOT offered: the back button uses a bespoke touch listener
     feeding the predictive-back animation, and binding its long press races that. The recents
     SHORT press stays hard-wired to "open recents": rebinding it is the one setting that can
     leave a user with no way back to the task switcher.

     Options in ichthys.nix. This file is the "system.buttons" page for
     frameworks/base/tools/ichthys-config/gen_crdroid_options.py. The preferences that came from
     the old Navigation, Miscellaneous, Status bar and Lock screen tabs keep the option paths
     they had there (system.navigation.*, system.misc.enableRotationButton, statusBar.*,
     lockscreen.doubleTapSleepLockscreen) through the generator's crdroid_paths.lock. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:lineage="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:key="button_settings"
    android:title="@string/ichthys_hub_navigation_title">

    <!-- Android's own navigation mode page (gestures or buttons). -->
    <Preference
        android:key="ichthys_navigation_mode"
        android:icon="@drawable/ic_navbar_mode"
        android:title="@string/ichthys_navigation_mode_title"
        android:summary="@string/ichthys_navigation_mode_summary"
        android:fragment="com.android.settings.gestures.SystemNavigationGestureSettings" />


    <!-- Navigation bar. Buttons.java drops the button-order switch in gesture navigation and the
         whole gesture category in 3-button navigation. How the bar is drawn (style, gesture
         pill) is in Look > Navigation bar. -->
    <PreferenceCategory
        android:key="navigation_buttons_category"
        android:title="@string/navigation_title">

        <com.crdroid.settings.preferences.SecureSettingSwitchPreference
            android:key="navigationbar_key_order"
            android:icon="@drawable/ic_navigation"
            android:title="@string/navbar_invert_layout_title"
            android:summary="@string/navbar_invert_layout_summary"
            android:defaultValue="true" />

        <!-- Rotation button. IchthysOS: SystemUI TaskbarDelegate also honours it now, so it works
             while the Launcher3 taskbar draws the navigation bar. -->
        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="enable_rotation_button"
            android:icon="@drawable/ic_rotation"
            android:title="@string/floating_rotation_button_title"
            android:summary="@string/floating_rotation_button_summary"
            android:defaultValue="true" />

        <!-- The navigation bar style picker: the IchthysOS code-drawn styles (navBar.style,
             Settings.Secure ichthys_navbar_style), applied live. -->
        <Preference
            android:key="theme_studio_navbar_style"
            android:icon="@drawable/ic_navbar"
            android:title="@string/theme_customization_navbar_title"
            android:summary="@string/theme_customization_navbar_summary"
            android:fragment="com.crdroid.settings.fragments.ui.NavbarStyles" />
    </PreferenceCategory>


    <PreferenceCategory
        android:key="navigation_gesture_category"
        android:title="@string/navigation_gesture_category_title">

        <com.crdroid.settings.preferences.SecureSettingSwitchPreference
            android:key="back_gesture_arrow"
            android:icon="@drawable/ic_navigation"
            android:title="@string/back_gesture_arrow_title"
            android:summary="@string/back_gesture_arrow_summary"
            android:defaultValue="true" />

        <com.crdroid.settings.preferences.SecureSettingSwitchPreference
            android:key="back_gesture_haptic"
            android:icon="@drawable/ic_navigation"
            android:title="@string/back_gesture_haptic_title"
            android:summary="@string/back_gesture_haptic_summary"
            android:defaultValue="true" />

        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="back_gesture_height"
            android:icon="@drawable/ic_navigation"
            android:title="@string/back_height_title"
            android:summary="@string/back_height_summary"
            android:defaultValue="0"
            android:max="3"
            settings:min="0"
            settings:interval="1" />

        <!-- IchthysOS: the four gesture pill rows are hidden. Only SystemUI's NavigationHandle
             reads them, and SystemUI's navigation bar is not created on this phone: the
             Launcher3 taskbar draws the pill (enable_taskbar_on_phones) and does not read these
             keys. Show them again once StashedHandleViewController honours them. -->
        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="ichthys_nav_handle_hide"
            settings:isPreferenceVisible="false"
            android:icon="@drawable/ic_navigation"
            android:disableDependentsState="true"
            android:title="@string/ichthys_nav_handle_hide_title"
            android:summary="@string/ichthys_nav_handle_hide_summary"
            android:defaultValue="false" />
        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="ichthys_nav_handle_width"
            settings:isPreferenceVisible="false"
            android:title="@string/ichthys_nav_handle_width_title"
            android:defaultValue="100"
            android:max="150"
            settings:min="30"
            settings:units="%"
            android:dependency="ichthys_nav_handle_hide" />
        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="ichthys_nav_handle_thickness"
            settings:isPreferenceVisible="false"
            android:dependency="ichthys_nav_handle_hide"
            android:title="@string/ichthys_nav_handle_thickness_title"
            android:defaultValue="100"
            android:max="250"
            settings:min="50"
            settings:units="%" />
        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="ichthys_nav_handle_opacity"
            settings:isPreferenceVisible="false"
            android:dependency="ichthys_nav_handle_hide"
            android:title="@string/ichthys_nav_handle_opacity_title"
            android:defaultValue="100"
            android:max="100"
            settings:min="10"
            settings:units="%" />
    </PreferenceCategory>


    <PreferenceCategory
        android:key="recents_category"
        android:title="@string/ichthys_recents_category">

        <!-- Recents style (recents.* in ichthys.nix). Read on every recents request by SystemUI
             and Launcher, so it applies at once. -->
        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="recents_type"
            android:icon="@drawable/ic_sysbar_recent"
            android:title="@string/recents_type_title"
            android:summary="%s"
            android:entries="@array/recents_type_entries"
            android:entryValues="@array/recents_type_values"
            android:defaultValue="0" />
        <!-- Options of the Slim style (frameworks/opt/slimrecent, compiled into Launcher3, which
             observes these keys). Buttons.java enables the row while that style is
             selected. -->
        <Preference
            android:key="slim_recents"
            android:icon="@drawable/ic_sysbar_recent"
            android:title="@string/look_recents_slim_title"
            android:summary="@string/look_recents_slim_summary"
            android:fragment="com.crdroid.settings.fragments.recents.SlimRecents" />
    </PreferenceCategory>


    <PreferenceCategory
        android:key="power_key"
        android:title="@string/hardware_keys_power_key_title" >

        <Preference
            android:key="power_menu"
            android:icon="@drawable/ic_settings_powermenu"
            android:title="@string/power_menu_title"
            android:summary="@string/power_menu_summary"
            android:fragment="com.crdroid.settings.fragments.buttons.PowerMenuActions" />

        <SwitchPreferenceCompat
            android:key="power_end_call"
            android:icon="@drawable/ic_end_call"
            android:title="@string/power_end_call_title"
            android:summary="@string/power_end_call_summary"
            android:persistent="false"/>

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="torch_long_press_power_gesture"
            android:icon="@drawable/ic_flashlight"
            android:title="@string/torch_long_press_power_gesture_title"
            android:summary="@string/torch_long_press_power_gesture_desc"
            android:defaultValue="false"
            lineage:requiresConfig="@*android:bool/config_supportLongPressPowerWhenNonInteractive" />

        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="torch_long_press_power_timeout"
            android:icon="@drawable/ic_timer_outline"
            android:title="@string/torch_long_press_power_timeout_title"
            android:defaultValue="0"
            android:dependency="torch_long_press_power_gesture"
            settings:defaultValueText="@string/never"
            android:max="600"
            settings:min="0"
            settings:interval="10"
            settings:units="@string/unit_seconds"
            lineage:requiresConfig="@*android:bool/config_supportLongPressPowerWhenNonInteractive" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="volume_keys"
        android:title="@string/hardware_keys_volume_keys_title" >

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="volume_wake_screen"
            android:icon="@drawable/ic_wake"
            android:title="@string/button_wake_title"
            android:summary="@string/button_wake_summary"
            android:defaultValue="false" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="volume_answer_call"
            android:icon="@drawable/ic_answer_call"
            android:title="@string/volume_answer_call_title"
            android:summary="@string/volume_answer_call_summary"
            android:defaultValue="false" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="volbtn_music_controls"
            android:icon="@drawable/ic_music"
            android:title="@string/volbtn_music_controls_title"
            android:summary="@string/volbtn_music_controls_summary"
            android:defaultValue="true" />

        <!-- Also seek while the screen is ON (not just off) -->
        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="volume_music_controls_screen_on"
            android:icon="@drawable/ic_music"
            android:title="@string/volume_music_controls_screen_on_title"
            android:summary="@string/volume_music_controls_screen_on_summary"
            android:defaultValue="false"
            android:dependency="volbtn_music_controls" />

        <!-- One step per press: holding a volume key won't keep changing volume -->
        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="volume_key_one_step"
            android:icon="@drawable/ic_music"
            android:title="@string/volume_key_one_step_title"
            android:summary="@string/volume_key_one_step_summary"
            android:defaultValue="false"
            android:dependency="volbtn_music_controls" />

        <ListPreference
            android:key="volume_key_cursor_control"
            android:icon="@drawable/ic_cursor"
            android:dialogTitle="@string/volbtn_cursor_control_title"
            android:title="@string/volbtn_cursor_control_title"
            android:entries="@array/volbtn_cursor_control_entries"
            android:entryValues="@array/volbtn_cursor_control_values"
            android:persistent="false" />

        <SwitchPreferenceCompat
            android:key="swap_volume_buttons"
            android:icon="@drawable/ic_rotation"
            android:title="@string/swap_volume_buttons_title"
            android:summary="@string/swap_volume_buttons_summary" />
    </PreferenceCategory>

    <!-- On-screen home button, handled by TaskbarNavButtonController. -->
    <PreferenceCategory
        android:key="home_key"
        android:title="@string/hardware_keys_home_key_title" >

        <ListPreference
            android:key="hardware_keys_home_long_press"
            android:icon="@drawable/ic_single_tap"
            android:dialogTitle="@string/hardware_keys_long_press_title"
            android:title="@string/hardware_keys_long_press_title"
            android:entries="@array/navbar_keys_action_entries"
            android:entryValues="@array/navbar_keys_action_values"
            android:persistent="false" />

        <ListPreference
            android:key="hardware_keys_home_double_tap"
            android:icon="@drawable/ic_double_tap"
            android:dialogTitle="@string/hardware_keys_double_tap_title"
            android:title="@string/hardware_keys_double_tap_title"
            android:entries="@array/navbar_keys_action_entries"
            android:entryValues="@array/navbar_keys_action_values"
            android:persistent="false" />
    </PreferenceCategory>

    <!-- On-screen recents button, handled by TaskbarNavButtonController. The back+recents
         long-press screen-unpin combo keeps priority over the long-press action while an app is
         pinned. -->
    <PreferenceCategory
        android:key="app_switch_key"
        android:title="@string/hardware_keys_appswitch_key_title" >

        <ListPreference
            android:key="hardware_keys_app_switch_long_press"
            android:icon="@drawable/ic_single_tap"
            android:dialogTitle="@string/hardware_keys_long_press_title"
            android:title="@string/hardware_keys_long_press_title"
            android:entries="@array/navbar_keys_action_entries"
            android:entryValues="@array/navbar_keys_action_values"
            android:persistent="false" />

        <ListPreference
            android:key="hardware_keys_app_switch_double_tap"
            android:icon="@drawable/ic_double_tap"
            android:dialogTitle="@string/hardware_keys_double_tap_title"
            android:title="@string/hardware_keys_double_tap_title"
            android:entries="@array/navbar_keys_action_entries"
            android:entryValues="@array/navbar_keys_action_values"
            android:persistent="false" />
    </PreferenceCategory>



    <PreferenceCategory
        android:key="gestures_screen_category"
        android:title="@string/ichthys_gestures_screen_category">

        <!-- Three fingers swipe action -->
        <ListPreference
            android:key="three_fingers_swipe"
            android:icon="@drawable/ic_three_finger_gesture"
            android:dialogTitle="@string/three_fingers_swipe_title"
            android:title="@string/three_fingers_swipe_title"
            android:entries="@array/three_fingers_swipe_action_entries"
            android:entryValues="@array/three_fingers_swipe_action_values"
            android:persistent="false" />
    </PreferenceCategory>



</PreferenceScreen>
