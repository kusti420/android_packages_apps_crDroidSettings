<!-- Look > Status bar > Battery: everything about how the battery is shown. Style and percentage
     of the status bar icon, the icon options of kusti420/ichthysos-tracker#37 (read live by
     SystemUI's BatteryRepositoryImpl / BatteryCustomization), the icon in the quick settings
     header, and the battery bar, which used to be a page of its own (battery_bar.xml).

     Options in ichthys.nix. The ichthys_battery_* options are hand-written (statusBar.battery.*
     in IchthysOptions.java). The others are generated by
     frameworks/base/tools/ichthys-config/gen_crdroid_options.py, whose crdroid_paths.lock keeps
     the paths they had on the pages they came from (statusBar.batteryTextCharging,
     statusBar.batteryBar.*). This file is deliberately not called battery_icon.xml any more:
     the generator skips a page of that name as a whole. -->
<PreferenceScreen
    android:title="@string/look_battery_title"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings">

    <PreferenceCategory
        android:key="battery_style_category"
        android:title="@string/look_battery_style_category">

        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_battery_style"
            android:summary="%s"
            android:title="@string/status_bar_battery_style_title"
            android:entries="@array/status_bar_battery_style_entries"
            android:entryValues="@array/status_bar_battery_style_values"
            android:defaultValue="0" />

        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_show_battery_percent"
            android:summary="%s"
            android:title="@string/status_bar_battery_percent_title"
            android:entries="@array/status_bar_battery_percent_entries"
            android:entryValues="@array/status_bar_battery_percent_values"
            android:defaultValue="0" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_battery_text_charging"
            android:title="@string/status_bar_battery_text_charging_title"
            android:summary="@string/status_bar_battery_text_charging_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/ichthys_battery_icon_look_category">

        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="ichthys_battery_scale"
            android:title="@string/ichthys_battery_scale_title"
            android:defaultValue="100"
            android:max="130"
            settings:min="80"
            settings:interval="5"
            settings:units="@string/unit_percent" />

        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="ichthys_battery_frame_thickness"
            android:title="@string/ichthys_battery_frame_thickness_title"
            android:summary="@string/ichthys_battery_frame_thickness_summary"
            android:defaultValue="3"
            android:max="5"
            settings:min="1" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="ichthys_battery_charging_indicator"
            android:title="@string/ichthys_battery_charging_indicator_title"
            android:summary="@string/ichthys_battery_charging_indicator_summary"
            android:defaultValue="false" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="ichthys_battery_powersave_indicator"
            android:title="@string/ichthys_battery_powersave_indicator_title"
            android:summary="@string/ichthys_battery_powersave_indicator_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/ichthys_battery_icon_percent_category">

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="ichthys_battery_percent_charging_only"
            android:title="@string/ichthys_battery_percent_charging_only_title"
            android:summary="@string/ichthys_battery_percent_charging_only_summary"
            android:defaultValue="false" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="ichthys_battery_percent_bold"
            android:title="@string/ichthys_battery_percent_bold_title"
            android:summary="@string/ichthys_battery_percent_bold_summary"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/ichthys_battery_icon_colors_category">

        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_battery_fill_mode"
            android:title="@string/ichthys_battery_fill_mode_title"
            android:entries="@array/ichthys_battery_fill_mode_entries"
            android:entryValues="@array/ichthys_battery_fill_mode_values"
            android:defaultValue="0" />

        <com.crdroid.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="ichthys_battery_fill_color"
            android:title="@string/ichthys_battery_fill_color_title"
            settings:accentDefault="true" />

        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="ichthys_battery_state_colors"
            android:title="@string/ichthys_battery_state_colors_title"
            android:entries="@array/ichthys_battery_state_colors_entries"
            android:entryValues="@array/ichthys_battery_state_colors_values"
            android:defaultValue="1" />

        <com.crdroid.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="ichthys_battery_charging_color"
            android:title="@string/ichthys_battery_charging_color_title"
            android:defaultValue="0xff18cc47" />

        <com.crdroid.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="ichthys_battery_powersave_color"
            android:title="@string/ichthys_battery_powersave_color_title"
            android:defaultValue="0xffffc917" />

        <com.crdroid.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="ichthys_battery_low_color"
            android:title="@string/ichthys_battery_low_color_title"
            android:defaultValue="0xffff0e01" />

        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="ichthys_battery_low_level"
            android:title="@string/ichthys_battery_low_level_title"
            android:summary="@string/ichthys_battery_low_level_summary"
            android:defaultValue="20"
            android:max="30"
            settings:min="5"
            settings:units="@string/unit_percent" />
    </PreferenceCategory>


    <!-- Battery bar: a thin level bar along the status bar. -->
    <PreferenceCategory
        android:key="battery_bar_category"
        android:title="@string/battery_bar_title">

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="statusbar_battery_bar"
            android:title="@string/battery_bar_title"
            android:summary="@string/battery_bar_summary"
            android:defaultValue="false" />

        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="statusbar_battery_bar_thickness"
            android:title="@string/battery_bar_thickness_title"
            android:defaultValue="2"
            android:max="4"
            settings:min="1"
            settings:units="@string/unit_dp"
            android:dependency="statusbar_battery_bar" />

        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="statusbar_battery_bar_style"
            android:title="@string/battery_bar_style_title"
            android:entries="@array/battery_bar_style_entries"
            android:entryValues="@array/battery_bar_style_values"
            android:defaultValue="0"
            android:dependency="statusbar_battery_bar" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="statusbar_battery_bar_blend_color"
            android:title="@string/battery_bar_blend_color_title"
            android:summary="@string/battery_bar_blend_color_summary"
            android:defaultValue="true"
            android:dependency="statusbar_battery_bar" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="statusbar_battery_bar_blend_color_reverse"
            android:title="@string/battery_bar_blend_color_reverse_title"
            android:summaryOn="@string/battery_bar_blend_color_reverse_summary_on"
            android:summaryOff="@string/battery_bar_blend_color_reverse_summary_off"
            android:dependency="statusbar_battery_bar_blend_color"
            android:defaultValue="false" />

        <!-- Unset follows the theme accent (SystemUI falls back to it), so no default here. -->
        <com.crdroid.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="statusbar_battery_bar_color"
            android:title="@string/battery_bar_color"
            settings:accentDefault="true"
            android:dependency="statusbar_battery_bar" />

        <com.crdroid.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="statusbar_battery_bar_battery_low_color"
            android:title="@string/battery_bar_battery_low_color"
            android:defaultValue="0xfff90028"
            android:dependency="statusbar_battery_bar" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="statusbar_battery_bar_animate"
            android:title="@string/battery_bar_animate_title"
            android:defaultValue="true"
            android:dependency="statusbar_battery_bar" />

        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="statusbar_battery_bar_enable_charging_color"
            android:title="@string/battery_bar_use_charging_color"
            android:defaultValue="true"
            android:dependency="statusbar_battery_bar" />

        <com.crdroid.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="statusbar_battery_bar_charging_color"
            android:title="@string/battery_bar_charging_color"
            android:defaultValue="0xffffc90f"
            android:dependency="statusbar_battery_bar_enable_charging_color" />
    </PreferenceCategory>
</PreferenceScreen>
