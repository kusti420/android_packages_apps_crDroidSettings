     Slim Recents (frameworks/opt/slimrecent) tuning. Only takes effect when
     Recents style = Slim (recents_type = 2). Read live by RecentController via
     ContentObservers, so most changes apply on the next panel open.
-->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings">

    <PreferenceCategory
        android:key="slim_recents_panel_category"
        android:title="@string/slim_recents_panel_category">

        <!-- Which side of the screen the panel sticks to -->
        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="recent_panel_gravity"
            android:icon="@drawable/ic_sysbar_recent"
            android:title="@string/slim_recents_gravity_title"
            android:summary="%s"
            android:entries="@array/slim_recents_gravity_entries"
            android:entryValues="@array/slim_recents_gravity_values"
            android:defaultValue="8388613" />

        <!-- Panel width / card size -->
        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="recent_panel_scale_factor"
            android:title="@string/slim_recents_scale_title"
            android:summary="@string/slim_recents_scale_summary"
            android:max="150"
            settings:min="60"
            settings:units="@string/unit_percent"
            android:defaultValue="115" />

        <!-- When cards show their live thumbnail expanded -->
        <com.crdroid.settings.preferences.SystemSettingListPreference
            android:key="recent_panel_expanded_mode"
            android:title="@string/slim_recents_expanded_title"
            android:summary="%s"
            android:entries="@array/slim_recents_expanded_entries"
            android:entryValues="@array/slim_recents_expanded_values"
            android:defaultValue="0" />

        <!-- How many recent apps to keep in the panel -->
        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="recents_max_apps"
            android:title="@string/slim_recents_max_apps_title"
            android:summary="@string/slim_recents_max_apps_summary"
            android:max="15"
            settings:min="3"
            android:defaultValue="15" />

        <!-- Card corner rounding -->
        <com.crdroid.settings.preferences.SystemSettingSeekBarPreference
            android:key="slim_recents_corner_radius"
            android:title="@string/slim_recents_corner_radius_title"
            android:summary="@string/slim_recents_corner_radius_summary"
            android:max="15"
            settings:min="0"
            settings:units="@string/unit_dp"
            android:defaultValue="5" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="slim_recents_membar_category"
        android:title="@string/slim_recents_membar_category">

        <!-- Show the RAM usage bar at the bottom of the panel -->
        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="slim_recents_mem_display"
            android:icon="@drawable/ic_memory"
            android:title="@string/slim_recents_mem_display_title"
            android:summary="@string/slim_recents_mem_display_summary"
            android:defaultValue="false" />

        <!-- Long-press the RAM bar to clear all recents -->
        <com.crdroid.settings.preferences.SystemSettingSwitchPreference
            android:key="slim_recents_mem_display_long_click_clear"
            android:title="@string/slim_recents_mem_clear_title"
            android:summary="@string/slim_recents_mem_clear_summary"
            android:defaultValue="false"
            android:dependency="slim_recents_mem_display" />

        <!-- RAM bar fill colour -->
        <com.crdroid.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="slim_mem_bar_color"
            android:title="@string/slim_recents_mem_bar_color_title"
            android:defaultValue="0x00ffffff"
            android:dependency="slim_recents_mem_display" />

        <!-- RAM bar text colour -->
        <com.crdroid.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="slim_mem_text_color"
            android:title="@string/slim_recents_mem_text_color_title"
            android:defaultValue="0x00ffffff"
            android:dependency="slim_recents_mem_display" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="slim_recents_appearance_category"
        android:title="@string/slim_recents_appearance_category">

        <!-- Panel background colour (transparent = theme default) -->
        <com.crdroid.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="recent_panel_bg_color"
            android:title="@string/slim_recents_panel_bg_color_title"
            android:summary="@string/slim_recents_color_auto_summary"
            android:defaultValue="0x00ffffff" />

        <!-- Card background colour (transparent = theme default) -->
        <com.crdroid.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="recent_card_bg_color"
            android:title="@string/slim_recents_card_bg_color_title"
            android:summary="@string/slim_recents_color_auto_summary"
            android:defaultValue="0x00ffffff" />

    </PreferenceCategory>

</PreferenceScreen>
