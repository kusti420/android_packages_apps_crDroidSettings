<?xml version="1.0" encoding="utf-8"?>
<!-- IchthysOS danger card (ichthys_danger_bg_single): red clone of settingslib_round_background_ichthys_danger_bg_single,
     preserved by SettingsPreferenceGroupAdapter branch 1 (DrawableStateLayout). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:colorControlHighlight"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">
    <item
        android:start="?android:attr/listPreferredItemPaddingStart"
        android:end="?android:attr/listPreferredItemPaddingEnd">
        <shape android:shape="rectangle">
            <solid android:color="#D32F2F" />
            <stroke android:width="1dp" android:color="#B71C1C" />
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp"
                android:bottomLeftRadius="20dp"
                android:bottomRightRadius="20dp" />
        </shape>
    </item>
</ripple>
