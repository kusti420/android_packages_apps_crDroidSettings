<resources>

    <style name="OptionTitleTextAppearance" parent="@android:style/TextAppearance.DeviceDefault.Widget.ActionBar.Title">
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineHeight">15sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="SupportStyle" parent="Theme.AppCompat.DayNight">
        <item name="android:colorBackground">@color/settingslib_materialColorSurfaceContainer</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorAccent">@*android:color/accent_device_default_light</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="CrDroidTabText" parent="TextAppearance.AppCompat.Body2">
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="CrDroidTabTextSelected" parent="TextAppearance.AppCompat.Body2">
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CrDroidTabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabTextAppearance">@style/CrDroidTabText</item>
        <item name="tabSelectedTextAppearance">@style/CrDroidTabTextSelected</item>

        <item name="tabTextColor">?android:attr/textColorSecondary</item>
        <item name="tabSelectedTextColor">?android:attr/textColorPrimary</item>

        <item name="tabIndicatorFullWidth">false</item>
        <!-- IchthysOS: these were pinned to fixed accent1 tones (200/300), which are light-theme
             tones; in dark mode they came out as a mid tone that does not match anything else on
             screen. Use the theme's accent/highlight so the tab strip follows the system palette in
             both light and dark. -->
        <item name="tabRippleColor">?android:attr/colorControlHighlight</item>

        <item name="tabIndicatorHeight">5dp</item>
        <item name="tabIndicatorColor">?android:attr/colorAccent</item>
        <item name="tabInlineLabel">true</item>
        <item name="tabMode">scrollable</item>

    </style>

    <!-- IchthysOS: accent1_600 is the LIGHT-theme accent tone and this overlay has no values-night
         counterpart, so in dark mode the app bar resolved its accent to a dark tone that clashed
         with the rest of the system. Follow the theme accent instead, which DeviceDefault already
         swaps per light/dark. -->
    <style name="CrDroidMaterialOverlay" parent="ThemeOverlay.MaterialComponents">
        <item name="colorAccent">?android:attr/colorAccent</item>
        <item name="colorPrimary">?android:attr/colorAccent</item>
        <item name="colorSecondary">?android:attr/colorAccent</item>
    </style>

    <style name="op_control_text_style_base">
        <item name="android:breakStrategy">simple</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="op_control_text_style_body1" parent="@style/op_control_text_style_base">
        <item name="android:textSize">13.0sp</item>
        <item name="android:fontFamily">@*android:string/config_bodyFontFamily</item>
    </style>
    
    <style name="op_control_text_style_h6" parent="@style/op_control_text_style_base">
        <item name="android:textSize">18.0sp</item>
        <item name="android:fontFamily">@*android:string/config_headlineFontFamilyMedium</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>
