<!-- Strings of the IchthysOS settings entry (ichthys_hub.xml) and the pages it opens. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Homepage entry and hub -->
    <string name="ichthys_hub_summary">Look, privacy, apps and system</string>
    <string name="ichthys_hub_look_title">Look</string>
    <string name="ichthys_hub_look_summary">Theme, status bar, quick settings, navigation bar, lock screen and volume</string>
    <string name="ichthys_hub_privacy_title">Privacy</string>
    <!-- IchthysOS: Guard finds and shows trackers but doesn't block them (HostRules.ENFORCED =
         false); the per-app firewall and data shields do work. Don't imply tracker blocking. -->
    <string name="ichthys_hub_shared_values_title">Shared values</string>
    <string name="ichthys_hub_shared_values_summary">Home city, trips, units and the fake place, set once for weather, sun times and Guard</string>
    <string name="ichthys_hub_privacy_summary">Guard: presets per app, firewall, data shields, verification and activity</string>
    <string name="ichthys_hub_apps_title">Apps</string>
    <!-- IchthysOS: the Apps page holds Ichthys Apps, Background (mostly lifts limits:
         unrestricted apps, Backstage), Installing (downgrades) and Integrity. -->
    <string name="ichthys_hub_apps_summary">Ichthys Apps, background, installing and integrity</string>
    <string name="ichthys_hub_system_title">System</string>
    <!-- IchthysOS: what the System page holds now; buttons, notifications and sound have their own hub rows. -->
    <string name="ichthys_hub_system_summary">Charging, charging animation, Smart Pixels, screenshot preview, duress PIN, ichthys.nix import and export, about</string>
    <!-- IchthysOS: toast when a link row is tapped and no browser is enabled. -->
    <string name="ichthys_no_browser">No browser is enabled. Link: <xliff:g id="url">%1$s</xliff:g></string>

    <!-- Apps -->
    <string name="ichthys_apps_store_title">Ichthys Apps</string>
    <string name="ichthys_apps_store_summary">Install and update apps</string>
    <string name="ichthys_apps_integrity_category">Integrity</string>
    <string name="ichthys_apps_install_category">Installing</string>

    <!-- Apps > Install & compatibility (ichthys_install.xml). Every summary names what the
         bypass gives up; these are the owner's deliberate holes in Android's blocks. -->
    <string name="ichthys_install_title">Install &amp; compatibility</string>
    <string name="ichthys_install_summary">Apps built for old Android, downgrades, screenshots in protected apps</string>
    <string name="ichthys_install_capture_category">Screenshots and screen recording</string>
    <string name="low_target_sdk_title">Allow apps built for old Android</string>
    <string name="low_target_sdk_summary">Install apps that target an Android version older than the system accepts (otherwise refused as built for an older version). They keep the permission behaviour of their time, which the block exists to stop malware hiding behind. Applies to every install, including adb.</string>
    <string name="secure_window_bypass_apps_title">Allow screenshots in selected apps</string>
    <!-- %1$s is secure_window_bypass_apps_none or secure_window_bypass_apps_count -->
    <string name="secure_window_bypass_apps_summary"><xliff:g id="count">%1$s</xliff:g>. Their own screenshot protection is ignored: screenshots, screen recording, casting, the recents preview and any app that can read the screen show them.</string>
    <string name="secure_window_bypass_apps_none">No apps selected</string>
    <plurals name="secure_window_bypass_apps_count">
        <item quantity="one">%d app</item>
        <item quantity="other">%d apps</item>
    </plurals>
    <string name="disable_secure_windows_title">Allow screenshots in every app</string>
    <string name="disable_secure_windows_summary">Ignores every screenshot protection on the device: all apps\u2019 secure windows and the system\u2019s own blocks for sensitive notifications and work policies. Anything that can record the screen, malware included, sees banking apps, passwords and payment screens.</string>

    <!-- Apps > Background -->
    <string name="ichthys_background_title">Background</string>
