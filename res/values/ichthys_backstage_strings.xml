<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- IchthysOS: Backstage (kusti420/ichthysos-tracker#38) -->
    <string name="backstage_title">Backstage</string>
    <string name="backstage_summary">Keep apps running as if they were open, on a hidden screen</string>
    <!-- IchthysOS: matches IchthysBackstageService today: an app opened again stays in Backstage
         and goes back to its hidden screen when you leave it; switching it off here brings it
         back to the screen; hidden tasks still show in recents (services.md B11), so not
         "never shown anywhere"; a hidden app keeps the whole phone awake. -->
    <string name="backstage_intro">Apps in Backstage keep running as if they were open on screen, for example to finish an upload that stops when you leave the app. You can use the phone and lock it as usual. Open an app from its icon, recents or its notification to use it; when you leave it, it goes back to running out of sight. To take an app out, switch it off here (it comes back on screen) or tap Stop in its notification (it closes). Add the Backstage tile to Quick Settings to send the app on screen with one tap. While an app runs out of sight the phone doesn\'t go into deep sleep, so Backstage uses a lot more battery. It is cleared when the phone restarts. Up to 3 apps at a time.</string>
    <string name="backstage_apps_category">Apps</string>
    <string name="backstage_app_running">In Backstage</string>
    <string name="backstage_full">Backstage is full (3 apps)</string>
    <string name="backstage_max_hours_title">Stop automatically after</string>
    <!-- IchthysOS: the service reads the limit when an app is added, so a change doesn't reach
         apps already in Backstage. %s is the chosen entry (ListPreference summary). -->
    <string name="backstage_max_hours_summary">%s, for apps sent to Backstage from now on</string>
    <!-- IchthysOS: -1 = the custom duration below (ichthys_backstage_max_minutes). -->
    <string-array name="backstage_max_hours_entries" translatable="false">
        <item>Never</item>
        <item>1 hour</item>
        <item>2 hours</item>
        <item>4 hours</item>
        <item>8 hours</item>
        <item>12 hours</item>
        <item>24 hours</item>
        <item>Custom</item>
    </string-array>
    <string-array name="backstage_max_hours_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>4</item>
        <item>8</item>
        <item>12</item>
        <item>24</item>
        <item>-1</item>
    </string-array>
    <!-- IchthysOS: the custom duration, shown only while "Custom" is chosen. -->
    <string name="backstage_max_minutes_title">Custom duration</string>
    <string name="backstage_max_minutes_unit">min</string>
    <!-- Summary of the custom duration: hours and minutes, e.g. "6 h 30 min". -->
    <string name="backstage_max_minutes_hours_minutes"><xliff:g id="hours" example="6">%1$d</xliff:g> h <xliff:g id="minutes" example="30">%2$d</xliff:g> min</string>
    <string name="backstage_max_minutes_hours"><xliff:g id="hours" example="6">%1$d</xliff:g> h</string>
    <string name="backstage_picker_h">h</string>
    <string name="backstage_picker_m">min</string>
    <string name="backstage_picker_hours" translatable="false">%1$d</string>
    <string name="backstage_picker_minutes" translatable="false">%1$s</string>
    <plurals name="backstage_duration_minutes">
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
</resources>
