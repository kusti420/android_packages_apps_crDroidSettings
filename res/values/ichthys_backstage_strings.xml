<resources>
    <!-- IchthysOS: Backstage (kusti420/ichthysos-tracker#38) -->
    <string name="backstage_title">Backstage</string>
    <string name="backstage_summary">Keep apps running as if they were open, on a hidden screen</string>
    <string name="backstage_intro">Apps in Backstage keep running as if they were open on screen, for example to finish an upload that stops when you leave the app. You can use the phone and lock it as usual; the apps are never shown anywhere. Add the Backstage tile to Quick Settings to send the app on screen with one tap; open the app again, or tap its notification, to bring it back. Backstage uses more battery and is cleared when the phone restarts. Up to 3 apps at a time.</string>
    <string name="backstage_apps_category">Apps</string>
    <string name="backstage_app_running">In Backstage</string>
    <string name="backstage_full">Backstage is full (3 apps)</string>
    <string name="backstage_max_hours_title">Stop automatically after</string>
    <!-- IchthysOS: the service reads the limit when an app is added, so a change doesn't reach
         apps already in Backstage. %s is the chosen entry (ListPreference summary). -->
    <string name="backstage_max_hours_summary">%s, for apps sent to Backstage from now on</string>
    <string-array name="backstage_max_hours_entries" translatable="false">
        <item>Never</item>
        <item>1 hour</item>
        <item>2 hours</item>
        <item>4 hours</item>
        <item>8 hours</item>
        <item>12 hours</item>
    </string-array>
    <string-array name="backstage_max_hours_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>4</item>
        <item>8</item>
        <item>12</item>
    </string-array>
</resources>
